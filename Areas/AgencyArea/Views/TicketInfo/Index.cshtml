@using Application.Models
@using Application.Services
@{
	ViewData["Title"] = "بلیط‌ها";
	Layout = "_AgencySideLayout";

	var tickets = ViewBag.tickets as List<Ticket> ?? new List<Ticket>();
	var page = ViewBag.page != null ? Convert.ToInt32(ViewBag.page) : 1;
	var totalPages = ViewBag.totalPages != null ? Convert.ToInt32(ViewBag.totalPages) : 1;
	var totalCount = ViewBag.totalCount != null ? Convert.ToInt32(ViewBag.totalCount) : tickets.Count;
	var activeCount = ViewBag.activeCount != null ? Convert.ToInt32(ViewBag.activeCount) : tickets.Count(t => !t.IsCancelled);
	var cancelledCount = ViewBag.cancelledCount != null ? Convert.ToInt32(ViewBag.cancelledCount) : tickets.Count(t => t.IsCancelled);
	if (page < 1) page = 1;
	if (totalPages < 1) totalPages = 1;
	var dateFilter = ViewBag.dateFilter as string;
	var isOrganization = ViewBag.isOrganization != null && Convert.ToBoolean(ViewBag.isOrganization);
	var hasInvoiceFinancialInfo = ViewBag.hasInvoiceFinancialInfo != null && Convert.ToBoolean(ViewBag.hasInvoiceFinancialInfo);
	var legalProfileUrl = ViewBag.legalProfileUrl as string ?? Url.Action("LegalProfile", "Agency");
	var showNeedLegalSwal = isOrganization && !hasInvoiceFinancialInfo;
	var pageSize = ViewBag.pageSize != null ? Convert.ToInt32(ViewBag.pageSize) : 20;
}

@section VendorStyles {
	<link rel="stylesheet" href="~/vendor/libs/flatpickr/flatpickr.css" />
	<link rel="stylesheet" href="~/vendor/libs/bootstrap-datepicker/bootstrap-datepicker.css" />
	<link rel="stylesheet" href="~/vendor/libs/bootstrap-daterangepicker/bootstrap-daterangepicker.css" />
	<link rel="stylesheet" href="~/vendor/libs/jquery-timepicker/jquery-timepicker.css" />
	<link rel="stylesheet" href="~/vendor/libs/pickr/pickr-themes.css" />
}

@section PageStyles {
	<link rel="stylesheet" href="~/css/fluent-color-icons.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/ticket-orders.css" asp-append-version="true" />
}

@section VendorScripts {
	<script src="~/libs/jquery.js"></script>
	<script src="~/vendor/libs/moment/moment.js"></script>
	<script src="~/vendor/libs/jdate/jdate.min.js" asp-append-version="true"></script>
	<script src="~/vendor/libs/flatpickr/flatpickr-jdate.js" asp-append-version="true"></script>
	<script src="~/vendor/libs/flatpickr/l10n/fa.js" asp-append-version="true"></script>
	<script src="~/vendor/libs/bootstrap-datepicker/bootstrap-datepicker.js"></script>
	<script src="~/vendor/libs/bootstrap-daterangepicker/bootstrap-daterangepicker.js"></script>
	<script src="~/vendor/libs/jquery-timepicker/jquery-timepicker.js"></script>
	<script src="~/vendor/libs/pickr/pickr.js"></script>
}

@section PageScripts {
	<script src="~/js/forms-pickers-jalali.js" asp-append-version="true"></script>
	<script src="~/js/ui-modals.js"></script>
}

<div class="ticket-orders" dir="rtl">
	<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
		<h4 class="mb-0">
			<span class="text-muted fw-light">خریدها /</span>
			لیست بلیط‌ها
		</h4>
		<button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#ticketFilterModal">
			<iconify-icon class="fc-icon me-1" icon="fluent-color:calendar-data-bar-24" width="18" height="18" aria-hidden="true"></iconify-icon>
			فیلتر تاریخ
		</button>
	</div>

	@if (!string.IsNullOrEmpty(dateFilter))
	{
		<div class="alert alert-secondary d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
			<span>نمایش بلیط‌ها در بازه <strong>@dateFilter</strong></span>
			<a class="btn btn-sm btn-outline-secondary" asp-action="Index">پاک کردن فیلتر</a>
		</div>
	}

	<!-- Summary widgets (OrderList pattern) -->
	<div class="card mb-4">
		<div class="card-widget-separator-wrapper">
			<div class="card-body card-widget-separator">
				<div class="row gy-4 gy-sm-1">
					<div class="col-sm-6 col-lg-4">
						<div class="d-flex justify-content-between align-items-start card-widget-1 border-end pb-3 pb-sm-0">
							<div>
								<h4 class="mb-2">@totalCount.ToString("N0")</h4>
								<p class="mb-0 fw-medium">کل بلیط‌ها</p>
							</div>
							<span class="ticket-orders__stat-icon me-sm-4" aria-hidden="true">
								<iconify-icon icon="fluent-color:receipt-24" width="28" height="28"></iconify-icon>
							</span>
						</div>
						<hr class="d-none d-sm-block d-lg-none me-4" />
					</div>
					<div class="col-sm-6 col-lg-4">
						<div class="d-flex justify-content-between align-items-start card-widget-2 border-end pb-3 pb-sm-0">
							<div>
								<h4 class="mb-2">@activeCount.ToString("N0")</h4>
								<p class="mb-0 fw-medium">فعال</p>
							</div>
							<span class="ticket-orders__stat-icon me-lg-4" aria-hidden="true">
								<iconify-icon icon="fluent-color:checkmark-circle-24" width="28" height="28"></iconify-icon>
							</span>
						</div>
						<hr class="d-none d-sm-block d-lg-none" />
					</div>
					<div class="col-sm-6 col-lg-4">
						<div class="d-flex justify-content-between align-items-start pb-3 pb-sm-0">
							<div>
								<h4 class="mb-2">@cancelledCount.ToString("N0")</h4>
								<p class="mb-0 fw-medium">لغو شده</p>
							</div>
							<span class="ticket-orders__stat-icon" aria-hidden="true">
								<iconify-icon icon="fluent-color:dismiss-circle-24" width="28" height="28"></iconify-icon>
							</span>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- Order list table -->
	<div class="card">
		<div class="card-header border-bottom d-flex flex-wrap justify-content-between align-items-center gap-2">
			<h5 class="card-title mb-0">بلیط‌های خریداری‌شده</h5>
			<small class="text-muted">
				@if (totalCount == 0)
				{
					<span>موردی برای نمایش نیست</span>
				}
				else
				{
					var fromItem = ((page - 1) * pageSize) + 1;
					var toItem = Math.Min(page * pageSize, totalCount);
					<span>نمایش @fromItem تا @toItem از @totalCount — @pageSize مورد در هر صفحه</span>
				}
			</small>
		</div>
		<div class="card-datatable table-responsive ticket-orders__scroll">
			<table class="datatables-order table border-top ticket-orders__table">
				<thead>
					<tr>
						<th>کد</th>
						<th>تاریخ</th>
						<th>مسافر</th>
						<th>تلفن</th>
						<th>وضعیت</th>
						<th>مسیر</th>
						<th>سرویس</th>
						<th>خودرو</th>
						<th class="text-center">عملیات</th>
					</tr>
				</thead>
				<tbody>
					@if (tickets.Count == 0)
					{
						<tr>
							<td colspan="9" class="text-center py-5 text-wrap">
								@if (!string.IsNullOrEmpty(dateFilter))
								{
									<p class="mb-1 fw-medium">بلیطی پیدا نشد</p>
									<small class="text-muted">در بازه انتخاب‌شده بلیطی ثبت نشده است.</small>
								}
								else
								{
									<p class="mb-1 fw-medium">هنوز بلیطی وجود ندارد</p>
									<small class="text-muted d-block mb-3">می‌توانید از صفحه اصلی سفر جستجو کنید.</small>
									<a class="btn btn-primary" asp-area="AgencyArea" asp-controller="Home" asp-action="Index">جستجوی سفرها</a>
								}
							</td>
						</tr>
					}
					else
					{
						foreach (var ticket in tickets)
						{
							var pdate = ticket.RegisteredAt.ToPersianDate();
							<tr>
								<td>
									<span class="fw-medium">#@ticket.TicketCode</span>
								</td>
								<td dir="ltr">
									<bdi>@($"{pdate.Year}/{pdate.Month:00}/{pdate.Day:00}")، @ticket.RegisteredAt.ToString("HH:mm")</bdi>
								</td>
								<td>
									<span class="ticket-orders__passenger-name">@ticket.Firstname @ticket.Lastname</span>
								</td>
								<td dir="ltr">@ticket.PhoneNumber</td>
								<td>
									@if (ticket.IsCancelled)
									{
										<span class="badge bg-label-secondary d-inline-flex align-items-center gap-1">
											<iconify-icon icon="fluent-color:dismiss-circle-24" width="14" height="14" aria-hidden="true"></iconify-icon>
											لغو شده
										</span>
									}
									else
									{
										<span class="badge bg-label-success d-inline-flex align-items-center gap-1">
											<iconify-icon icon="fluent-color:checkmark-circle-24" width="14" height="14" aria-hidden="true"></iconify-icon>
											فعال
										</span>
									}
								</td>
								<td>@ticket.TripOrigin به @ticket.TripDestination</td>
								<td>@ticket.ServiceName</td>
								<td>@ticket.CarName</td>
								<td class="text-center">
									<div class="dropdown">
										<button type="button" class="btn btn-sm btn-icon dropdown-toggle hide-arrow" data-bs-toggle="dropdown" aria-expanded="false" aria-label="عملیات">
											<i class="ti ti-dots-vertical"></i>
										</button>
										<div class="dropdown-menu dropdown-menu-end m-0">
											<a class="dropdown-item"
											   asp-area="AgencyArea"
											   asp-controller="CustomerService"
											   asp-action="TripReceiptPDF"
											   asp-route-reference="@ticket.TicketCode">
												<iconify-icon class="fc-icon me-1" icon="fluent-color:receipt-24" width="16" height="16" aria-hidden="true"></iconify-icon>
												چاپ بلیط
											</a>
											@if (!ticket.IsCancelled)
											{
												if (isOrganization)
												{
													if (hasInvoiceFinancialInfo)
													{
														<a class="dropdown-item"
														   target="_blank"
														   rel="noopener"
														   asp-area="AgencyArea"
														   asp-controller="OfficialInvoices"
														   asp-action="Create"
														   asp-route-ticketcode="@ticket.TicketCode">
															<iconify-icon class="fc-icon me-1" icon="fluent-color:document-text-24" width="16" height="16" aria-hidden="true"></iconify-icon>
															فاکتور رسمی
														</a>
													}
													else
													{
														<a href="@legalProfileUrl" class="dropdown-item js-invoice-need-legal">
															<iconify-icon class="fc-icon me-1" icon="fluent-color:document-text-24" width="16" height="16" aria-hidden="true"></iconify-icon>
															فاکتور رسمی
														</a>
													}
												}
												else if (!string.IsNullOrWhiteSpace(ticket.HeadOfPassengers))
												{
													<a class="dropdown-item"
													   target="_blank"
													   rel="noopener"
													   asp-area="AgencyArea"
													   asp-controller="OfficialInvoices"
													   asp-action="Create"
													   asp-route-ticketcode="@ticket.TicketCode">
														<iconify-icon class="fc-icon me-1" icon="fluent-color:document-text-24" width="16" height="16" aria-hidden="true"></iconify-icon>
														فاکتور رسمی
													</a>
												}
												else
												{
													<span class="dropdown-item disabled text-muted" title="ابتدا سرپرست مسافرین را در رزرو وارد کنید">
														<iconify-icon class="fc-icon me-1" icon="fluent-color:document-text-24" width="16" height="16" aria-hidden="true"></iconify-icon>
														فاکتور رسمی (نیاز به سرپرست)
													</span>
												}
											}
										</div>
									</div>
								</td>
							</tr>
						}
					}
				</tbody>
			</table>
		</div>

		@if (totalPages > 1)
		{
			<div class="card-footer d-flex flex-wrap justify-content-between align-items-center gap-2">
				<small class="text-muted">صفحه @(page) از @totalPages</small>
				<nav aria-label="صفحه‌بندی بلیط‌ها">
					<ul class="pagination pagination-sm mb-0">
						<li class="page-item @(page <= 1 ? "disabled" : null)">
							<a class="page-link"
							   asp-action="Index"
							   asp-route-page="@(page - 1)"
							   asp-route-datesFilter="@dateFilter"
							   tabindex="@(page <= 1 ? -1 : null)">قبلی</a>
						</li>
						@{
							var startPage = Math.Max(1, page - 2);
							var endPage = Math.Min(totalPages, page + 2);
						}
						@for (var p = startPage; p <= endPage; p++)
						{
							<li class="page-item @(p == page ? "active" : null)">
								<a class="page-link"
								   asp-action="Index"
								   asp-route-page="@p"
								   asp-route-datesFilter="@dateFilter">@p</a>
							</li>
						}
						<li class="page-item @(page >= totalPages ? "disabled" : null)">
							<a class="page-link"
							   asp-action="Index"
							   asp-route-page="@(page + 1)"
							   asp-route-datesFilter="@dateFilter"
							   tabindex="@(page >= totalPages ? -1 : null)">بعدی</a>
						</li>
					</ul>
				</nav>
			</div>
		}
	</div>
</div>

<div class="modal fade" id="ticketFilterModal" tabindex="-1" aria-labelledby="ticketFilterModalTitle" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered" role="document">
		<div class="modal-content">
			<div class="modal-header">
				<div class="d-flex align-items-center gap-2">
					<iconify-icon icon="fluent-color:calendar-data-bar-24" width="22" height="22" aria-hidden="true"></iconify-icon>
					<div>
						<h5 class="modal-title mb-0" id="ticketFilterModalTitle">فیلتر بلیط‌ها</h5>
						<small class="text-muted">بر اساس زمان خرید</small>
					</div>
				</div>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
			</div>
			<div class="modal-body">
				<form class="d-flex gap-2" asp-action="Index" method="get">
					<input type="hidden" name="page" value="1" />
					<input value="@dateFilter" name="datesFilter" class="form-control" id="bs-rangepicker-basic" type="text" placeholder="بازه تاریخ" />
					<button type="submit" class="btn btn-primary text-nowrap">جستجو</button>
				</form>
				@if (!string.IsNullOrEmpty(dateFilter))
				{
					<a class="btn btn-sm btn-link px-0 mt-2" asp-action="Index">
						<i class="ti ti-backspace"></i>
						پاک کردن فیلتر
					</a>
				}
			</div>
		</div>
	</div>
</div>

@if (showNeedLegalSwal)
{
	ViewData["FinancialInfoUrl"] = legalProfileUrl;
	ViewData["AutoShowFinancialAlert"] = false;
	ViewData["FinancialAlertBindSelector"] = ".js-invoice-need-legal";
	@await Html.PartialAsync("_NeedFinancialInfoSwal")
}
