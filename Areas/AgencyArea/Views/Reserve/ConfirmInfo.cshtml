@{
        Layout = "_AgencySideLayout";
    ViewData["title"] = "تایید نهایی";

    var trip = (Application.Services.MrShooferORS.SearchedTrip)ViewBag.trip;

    var reserve_viemodel = (Application.ViewModels.Reserve.ReserveInfoViewModel)ViewBag.reserveviewmodel;

    var agancy = (Agency)ViewBag.agancy;
    bool canPayWithCredit = ViewBag.canbuy is bool buy && buy;
    int agencyBalance = ViewBag.agancy_balance is int bal ? bal : 0;

    Dictionary<int, string> monthName = new Dictionary<int, string>()
    {
    {1,"فروردین" },
    {2,"اردیبهشت"},
    {3, "خرداد"},
    {4, "تیر" },
    {5,"مرداد"},
    {6, "شهریور" },
    {7, "مهر" },
    {8, "آبان" },
    {9, "آذر" },
    {10, "دی" },
    {11, "بهمن" },
    {12, "اسفند" }
    };

}

<style>

    @@media only screen and (max-width: 600px) {

        .px-14 {
            padding-left: .2rem !important;
            padding-right: .2rem !important;
        }

        .step-title {
            font-size: .75rem !important;
        }
    }

</style>

<style>
    .validation-message {
        margin-top: .45rem;
        font-size: .8rem;
    }

    .success-payment {
        background-color: RGBA(var(--bs-success-rgb), .25) !important;
    }

    .not_enough_payment {
        background-color: RGBA(var(--bs-secondary-rgb), .25) !important;
    }

    .pm-pick {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: .85rem;
        padding: 1rem 1.1rem;
        border: 2px solid #ececec;
        border-radius: 1rem;
        cursor: pointer;
        margin: 0;
        width: 100%;
        text-align: start;
    }
    .pm-pick.selected { border-color: #7367f0; background: #f8f7ff; }
    .pm-pick.disabled { opacity: .55; cursor: not-allowed; }
    .pm-pick-icon {
        flex: 0 0 2.4rem;
        width: 2.4rem;
        height: 2.4rem;
        border-radius: .7rem;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eef0ff;
        color: #5e50ee;
        font-size: 1.25rem;
        line-height: 1;
    }
    .pm-pick-copy {
        flex: 1 1 auto;
        min-width: 0;
        text-align: start;
    }
    .pm-pick-copy strong {
        display: block;
        font-size: 1rem;
        line-height: 1.7;
        color: #2f2b3d;
        font-weight: 700;
    }
    .pm-pick-copy small {
        display: block;
        margin-top: .15rem;
        font-size: .8125rem;
        line-height: 1.7;
        color: #6d6b77;
    }
    .pm-pick input {
        flex: 0 0 auto;
        margin: 0;
        accent-color: #7367f0;
    }
    #paymentmodal {
        direction: rtl;
        text-align: right;
        font-family: inherit;
    }
    #paymentmodal .modal-header {
        padding: 1.15rem 1.25rem .85rem;
        border-bottom: 1px solid #ececec;
    }
    .pm-modal-head {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: .9rem;
        width: 100%;
    }
    .pm-modal-head .btn-close {
        margin-inline-start: auto;
        margin-inline-end: 0;
        flex-shrink: 0;
    }
    .pm-modal-icon {
        flex: 0 0 2.75rem;
        width: 2.75rem;
        height: 2.75rem;
        border-radius: .85rem;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eef0ff;
        color: #5e50ee;
        font-size: 1.45rem;
    }
    .pm-modal-copy {
        flex: 1 1 auto;
        min-width: 0;
        text-align: start;
    }
    .pm-modal-copy .modal-title {
        margin: 0;
        font-size: 1.15rem;
        line-height: 1.7;
        font-weight: 700;
    }
    .pm-modal-copy small {
        display: block;
        margin-top: .2rem;
        font-size: .8125rem;
        line-height: 1.7;
        color: #6d6b77;
    }
    #paymentmodal .success-payment {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: .75rem;
        text-align: start;
        padding-inline: 1rem;
    }
    #paymentmodal .success-payment h6 {
        margin: 0;
        line-height: 1.7;
        text-align: start;
    }
    #paymentmodal .success-payment small {
        display: block;
        line-height: 1.7;
        text-align: start;
    }

    .form-control {
        font-size: 1.07rem;
    }

    .form-check-label {
        padding-top: .42em !important;
        padding-bottom: .42em !important;
    }

    .border-divider, .border-gray-75 {
        --tw-border-opacity: 1;
        border-color: rgb(230 232 238 / var(--tw-border-opacity));
    }

    .input-forms {
        --bs-gutter-x: 0 !important;
        --bs-gutter-y: 0;
    }

    .border-1 {
        border-width: .063rem;
    }

    .rounded-5 {
        border-radius: 1.25rem;
    }

    .bg-white {
        --tw-bg-opacity: 1;
        background-color: rgb(255 255 255 / var(--tw-bg-opacity));
    }

    .shadow-7\.5__13__5__gray30 {
        --tw-shadow: 0 1.875rem 3.125rem 1.25rem hsla(0,0%,95%,.3);
        --tw-shadow-colored: 0 1.875rem 3.125rem 1.25rem var(--tw-shadow-color);
    }

    .shadow-1__4\.5__black\/8, .shadow-7\.5__13__5__gray30 {
        box-shadow: var(--tw-ring-offset-shadow, 0 0 #0000), var(--tw-ring-shadow, 0 0 #0000), var(--tw-shadow);
    }

    .headline {
        justify-content: space-between;
    }

    *, :after, :before {
        box-sizing: border-box;
        border: 0 solid #a0a0b3;
    }

    .font-bold {
        font-weight: 700;
    }

    .text-blck {
        --tw-text-opacity: 1;
        color: rgb(41 38 61 / var(--tw-text-opacity));
    }

    .text-white {
        --tw-text-opacity: 1;
        color: rgb(255 255 255 / var(--tw-text-opacity));
    }

    .bg-divider {
        --tw-bg-opacity: 1;
        background-color: rgb(230 232 238 / var(--tw-bg-opacity));
        height: .063rem;
        flex: 1 1;
    }

    .steps {
        justify-content: space-between;
    }

    .step-container {
        justify-content: space-between;
        align-items: center;
        display: flex;
        flex: 1 1;
    }


    .step {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .step-title {
        font-size: 1rem;
        line-height: 1.5rem;
    }

    .selected {
        color: #7367f0;
    }


    @@media only screen and (min-width: 960px) {
        .px-lg-6 {
            padding-right: 2.6rem !important;
            padding-left: 2.6rem !important;
        }
    }

    @@media only screen and (min-width: 1200px) {
        .px-lg-6 {
            padding-right: 8.8rem !important;
            padding-left: 8.8rem !important;
        }
    }


    .shadow-1__2__gray\/75, .shadow-1__6__gray\/75 {
        box-shadow: var(--tw-ring-offset-shadow, 0 0 #0000), var(--tw-ring-shadow, 0 0 #0000), var(--tw-shadow);
    }

    .shadow-1__2__gray\/75 {
        --tw-shadow: 0px 2px 8px 0px rgba(38,50,80,.07);
        --tw-shadow-colored: 0px 2px 8px 0px var(--tw-shadow-color);
    }

    .px-14 {
        padding-left: 3.2rem;
        padding-right: 3.2rem;
    }

    .py-7\.5 {
        padding-top: 1.175rem;
        padding-bottom: 1.175rem;
    }

    .bg-white {
        --tw-bg-opacity: 1;
        background-color: rgb(255 255 255 / var(--tw-bg-opacity));
    }

    .border-divider, .border-gray-75 {
        --tw-border-opacity: 1;
        border-color: rgb(230 232 238 / var(--tw-border-opacity));
    }

    .border-1 {
        border-width: .063rem;
    }

    .rounded-3xl {
        border-radius: 1.5rem;
    }

    .rounded-5 {
        border-radius: 1.25rem;
    }

    .w-full {
        width: 100%;
    }

    .confirm-card {
        padding: 1.15rem 1.25rem !important;
        margin-top: .7rem;
    }
    .confirm-card hr {
        margin: 1rem 0;
    }
    .confirm-trip-route {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 1rem;
        padding: .85rem .15rem 0;
        margin: 0;
        text-align: center;
    }
    .confirm-trip-meta {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: .75rem;
        padding: .15rem 0;
        align-items: start;
    }
    .confirm-price-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1rem;
        margin-top: 1rem;
    }
    .confirm-price-row h5 {
        margin: 0;
        line-height: 1.7;
    }
    .confirm-price-hint {
        margin: .7rem 0 0;
        text-align: right;
        font-size: .75rem;
        line-height: 1.7;
        color: #6d6b77;
    }
    .confirm-buyer-top {
        display: grid;
        grid-template-columns: 3.75rem 1fr 1fr 1fr;
        gap: .75rem 1rem;
        align-items: center;
        direction: rtl;
        text-align: right;
    }
    .confirm-buyer-top small,
    .confirm-buyer-mid small {
        display: block;
        margin-bottom: .2rem;
        line-height: 1.7;
    }
    .confirm-buyer-top h5,
    .confirm-buyer-mid h5 {
        margin: 0;
        line-height: 1.7;
    }
    .confirm-buyer-mid {
        display: grid;
        grid-template-columns: minmax(10rem, .9fr) minmax(0, 1.4fr);
        gap: .85rem 1rem;
        align-items: center;
        margin-top: 1rem;
        direction: rtl;
    }
    .confirm-note {
        display: block;
        margin-top: .9rem;
        text-align: right;
        font-size: .75rem;
        line-height: 1.7;
        color: #6d6b77;
    }
    .confirm-actions {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 1rem;
        margin-top: 1rem;
    }
    .confirm-actions .btn {
        flex: 0 0 auto;
        width: min(18rem, 100%);
        height: 3.5rem !important;
        border-radius: 1.6rem !important;
        margin: 0;
    }
    .confirm-location-hint {
        flex: 1 1 auto;
        margin: 0;
        text-align: right;
        line-height: 1.7 !important;
        font-size: .8rem !important;
        color: #6d6b77;
    }
    @@media (max-width: 767.98px) {
        .confirm-buyer-top,
        .confirm-buyer-mid,
        .confirm-actions {
            display: flex;
            flex-direction: column;
            align-items: stretch;
        }
        .confirm-actions .btn { width: 100%; }
        .confirm-location-hint { text-align: right; }
    }
</style>

@section VendorStyles {
    <link rel="stylesheet" href="~/vendor/libs/animate-css/animate.css">
    <link rel="stylesheet" href="~/vendor/libs/flatpickr/flatpickr.css" />
}
@section PageScripts {
    <script src="~/js/ui-modals.js"></script>
}

<div class="main_container px-lg-6 px-0">
    <div class="bg-white rounded-5 border border-divider w-full rounded-3xl py-7.5 px-14 shadow-1__2__gray/75 ">

        <div class="d-flex steps">
            <div class="step-container">
                <div class="step">
                    <i class="ti ti-checks ti-lg px-4 d:pb-4 text-success"></i>

                    @* <img src="/ok.png" height="40px;" /> *@
                    <span class="pt-1 step-title">
                        اطلاعات مسافر
                    </span>
                </div>
                <div class="h-[0.063rem] flex-1  bg-divider"></div>
            </div>

            <div class="step-container selected">
                <div class="step">
                    <i class="ti ti-certificate ti-lg px-4 d:pb-4"></i>
                    <span class="pt-1 step-title ">
                        رزور و تایید
                    </span>
                </div>
                <div class="h-[0.063rem] flex-1  bg-divider"></div>
            </div>

            <div class="step-container">
                <div class="step">
                    <i class="ti ti-building-bank ti-lg px-4 d:pb-4 "></i>
                    <span class="pt-1 step-title">
                        پرداخت
                    </span>
                </div>
                <div class="h-[0.063rem] flex-1  bg-divider"></div>
            </div>

            <div class="step-container" style="flex: none;">
                <div class="step">
                    <i class="ti ti-ticket ti-lg px-4 d:pb-4"></i>
                    <span class="pt-1 step-title">
                        صدور
                    </span>
                </div>
            </div>
        </div>

    </div>

    <div class="downside-contaner mt-5 row">
        <div class="mb-4">

            <div class="d-flex justify-content-between align-items-baseline">
              <div>

                <h2 class="mb-2 font-bold" style="font-size: 1.5rem; line-height: 2rem; --tw-text-opacity: 1; color: rgb(41 38 61 / var(--tw-text-opacity));">تایید اطلاعات و رزرو</h2>
                <small>اطلاعات مسافر و سفر را تایید نهایی کنید</small>
              </div>

                <span onclick="window.history.back();">
                    بازگشت
                    <i class="ti ti-arrow-back-up"></i>
                </span>
            </div>

            
        </div>


        <div class="col-md-6 col-12">

            <div class="d-flex justify-content-start">


                <img class="d-inline" src="/taxiloc.png" height="47px" />

                <h4 class="ms-2 d-inline">سفر</h4>


            </div>
            <div class="card rounded-5 confirm-card col-12 mt-0">

                <div class="headline d-flex justify-between">
                    <span class="badge bg-dark rounded-pill py-2" style="font-size: .875rem!important">
                        @trip.taxiSupervisorName
                    </span>
                    <div class="capacity badge bg-label-secondary rounded-pill">
                        <i class="ti ti-armchair-2 d-inline"></i>
                        |
                        @* <span class="badge bg-label-danger">دربتسی</span> *@
                        <small class="text-danger ms-1 d-inline t-bold">دربستی</small>
                    </div>
                </div>


                @* مبدا و مقصد *@
                <div class="confirm-trip-route">
                    <span>
                        <small class="d-block ms-1 ">
                            <img src="/redpin.png" height="18px;" />
                            مبدا
                        </small>
                        <span class="fs-5 text-blck">
                            @trip.originCityName
                        </span>
                        <small>
                            @trip.oringinLocationName
                        </small>
                    </span>

                    <span style="align-self: end;" class="mb-1">
                        <span>
                            ....
                        </span>
                        <img src="/taxi.png" height="30px" />
                        <span>
                            ....
                        </span>
                    </span>

                    <span>
                        <small class="d-block ms-1 ">
                            <img src="/redpin.png" height="18px;" />
                            مقصد
                        </small>
                        <span class="fs-5 text-blck">
                            @trip.destinationCityName
                        </span>
                        <small>
                            @trip.destinationLocationName
                        </small>
                    </span>
                </div>

                <hr />
                @* تاریخ و خودرو *@


                <div class="confirm-trip-meta">

                    <div class="col-4 d-flex flex-column align-items-center">

                        <small>
                            <i class="ti ti-calendar-event"></i>
                            تاریخ سفر
                        </small>

                        <div class="d-flex mt-1" style="justify-content: space-between;">
                            @{
                                var pdate = new Application.Services.PersianDate(trip.startingDateTime);
                            }

                            <div>
                                <span class="text-blck fs-5">
                                    @pdate.Day
                                    @monthName[pdate.Month]
                                </span>
                                <span class="fs-5 ms-1">
                                    @pdate.DayOfWeek
                                </span>

                            </div>
                        </div>
                    </div>


                    <div class="col-4 d-flex flex-column align-items-center">
                        <small>
                            <i class="ti ti-clock"></i>
                            ساعت
                        </small>

                        <span class="text-blck fs-5 mt-1">
                            @trip.startingDateTime.ToString("HH:mm")
                            @{
                                if (trip.startingDateTime.Hour >= 0 && trip.startingDateTime.Hour <= 11)
                                {
                                    <small>(صبح)</small>
                                }

                                else if (trip.startingDateTime.Hour >= 12 && trip.startingDateTime.Hour < 15)
                                {
                                    <small>(ظهر)</small>
                                }

                                else if (trip.startingDateTime.Hour >= 15 && trip.startingDateTime.Hour <= 19)
                                {
                                    <small>(بعداز ظهر)</small>
                                }

                                else
                                {
                                    <small>(شب)</small>

                                }

                            }
                        </span>
                    </div>

                    <div class="col-4 d-flex flex-column align-items-center">
                        <small>
                            <i class="ti ti-car"></i>
                            خودرو
                            @if (trip.taxiSupervisorID == 7)
                            {
                                <img src="/vip_badge.png" style="height:27px;">
                            }
                        </small>

                        <span class="text-blck fs-5">
                            <div class="d-flex mt-1" style="justify-content: space-between; font-size: 1rem;">
                                <span>
                                    @{ var models = (trip.carModelName ?? string.Empty).Split('|', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries); }
                                    @foreach (var m in models)
                                    {
                                        <span class="text-blck badge bg-label-primary rounded-pill carmodel me-1">@m</span>
                                    }
                                </span>
                            </div>
                        </span>
                    </div>

                </div>


                <div class="col-12">
                    <div class="confirm-price-row">
                        <div>
                            <h5>قـیمت پرداختی خریدار</h5>
                        </div>
                        <div>

                            @if (trip.afterdiscticketprice != trip.originalTicketprice)
                            {
                                <div class="text-end mb-0">
                                    <h5 class="text-black mb-0">
                                        <s>
                                            <bdi>
                                                <svg class="toman">
                                                    <use xlink:href="#toman">
                                                        <symbol id="toman" viewBox="0 0 14 14" xmlns="http://www.w3.org/2000/svg">
