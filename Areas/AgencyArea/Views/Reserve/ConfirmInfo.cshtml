                    </symbol>
                </svg>

            </div>
        </div>

        <div class="col-md-6 col-12 mt-4  mt-md-0">
            <div class="d-flex justify-content-start">
                <img src="/useravatar.png" height="35px" />
                <h4 class="ms-2">اطلاعات خریدار</h4>
            </div>
            <div class="card rounded-5 confirm-card mt-0">
                <div class="confirm-buyer-top">
                    <div>
                        @{
                            if (reserve_viemodel.Gender == "male")
                            {
                                <img src="/male.png" height="56px" alt="" />
                            }
                            else
                            {
                                <img src="/female.png" height="56px" alt="" />
                            }
                        }
                    </div>
                    <div>
                        <small>نام</small>
                        <h5>
                            @{
                                if (reserve_viemodel.Gender == "male")
                                {
                                    @:آقای
                                }
                                else
                                {
                                    @:خانم
                                }
                            }
                            @reserve_viemodel.Firstname
                        </h5>
                    </div>
                    <div>
                        <small>نام خانوادگی</small>
                        <h5>@reserve_viemodel.Lastname</h5>
                    </div>
                    <div>
                        <small>کد ملی</small>
                        <h5>@reserve_viemodel.NaCode</h5>
                    </div>
                </div>

                <div class="confirm-buyer-mid">
                    <div>
                        <small>
                            شماره تلفن همراه
                            <a class="buyer-phone-edit link" data-bs-target="#modalCenter" data-bs-toggle="modal" href="javascript:void(0);">
                                ویرایش<i class="ti ti-pencil"></i>
                            </a>
                        </small>
                        <h5 id="numberphone_display">@reserve_viemodel.NumebrPhone</h5>
                    </div>
                </div>

                <div class="confirm-buyer-notices">
                    <div class="confirm-buyer-notice">
                        <i class="ti ti-message-2" aria-hidden="true"></i>
                        <p>بعد از ثبت خرید و صدور بلیط، لینک اطلاعات سفر و فایل بلیط برای مسافر ارسال می‌شود</p>
                    </div>
                    <div class="confirm-buyer-notice">
                        <img src="/location.png" height="22" width="22" alt="" />
                        <p>پس از ثبت و تایید بلیط، مکان دقیق مقصد و مبدا توسط <strong>مسترشوفر</strong> با مسافر هماهنگ خواهد شد.</p>
                    </div>
                </div>
            </div>
            <div class="confirm-actions">
                <button data-bs-target="#paymentmodal" data-bs-toggle="modal" class="btn btn-lg btn-primary">تایید و ادامه</button>
            </div>
        </div>
    </div>

</div>





<div class="col-lg-4 col-md-6">
    <small class="text-light fw-medium"></small>
    <div class="mt-3">
        <!-- Modal -->
        <div aria-hidden="true" class="modal fade" id="modalCenter" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <div class="d-flex justify-content-start align-items-center">
                            <img src="/hand-edit.png" height="50px;" />
                            <h5 class="modal-title ms-2" id="modalCenterTitle">ویرایش شماره تلفن مسافر</h5>
                            <button aria-label="بستن" class="btn-close" data-bs-dismiss="modal" type="button"></button>
                        </div>
                    </div>
                    <div class="modal-body">
                        <div class="row">
                            <div class="col mb-2">
                                <small class="form-label" for="nameWithTitle">شماره تلفن</small>
                                <input class="form-control form-control-lg" id="newnumberphone" value="@reserve_viemodel.NumebrPhone" />
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer d-flex justify-content-between">
                        <button class="btn btn-label-secondary" data-bs-dismiss="modal" type="button"> بستن</button>
                        <button class="btn btn-primary" type="button" onclick="ChangeNumber()">ذخیره</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>




<div class="col-lg-4 col-md-6 col-12">
    <small class="text-light fw-medium"></small>
    <div class="mt-4">
