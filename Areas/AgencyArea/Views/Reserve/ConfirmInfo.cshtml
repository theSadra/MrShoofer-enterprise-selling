@{
        Layout = "_AgencySideLayout";
    ViewData["title"] = "تایید نهایی";

    var trip = (Application.Services.MrShooferORS.SearchedTrip)ViewBag.trip;

    var reserve_viemodel = (Application.ViewModels.Reserve.ReserveInfoViewModel)ViewBag.reserveviewmodel;

    var agancy = (Agency)ViewBag.agancy;
    bool canPayWithCredit = ViewBag.canbuy is bool buy && buy;
    int agencyBalance = 0;
    try { agencyBalance = Convert.ToInt32(ViewBag.agancy_balance ?? 0); } catch { agencyBalance = 0; }
    int listPrice = ViewBag.listPrice is int lp ? lp : trip.afterdiscticketprice;
    // Payable amount is computed in ReserveController (commission already applied).
    int ticketPrice = ViewBag.payablePrice is int pp ? pp : listPrice;
    try { if (ViewBag.payablePrice != null) ticketPrice = Convert.ToInt32(ViewBag.payablePrice); } catch { }
    bool showListStrike = ticketPrice != listPrice || trip.afterdiscticketprice != trip.originalTicketprice;
    int strikePrice = ticketPrice != listPrice ? listPrice : trip.originalTicketprice;
    bool canPayHybrid = agencyBalance > 0 && agencyBalance < ticketPrice;
    int hybridRemainder = canPayHybrid ? ticketPrice - agencyBalance : 0;
    // Keep canbuy in sync with parsed balance (avoids type-boxing mismatches).
    canPayWithCredit = agencyBalance >= ticketPrice;
    bool canUseWallet = agencyBalance > 0;
    // Use wallet whenever there is balance (full cover → 0 gateway; shortfall → hybrid remainder).
    bool walletToggleDefault = canUseWallet;
    string defaultPm = canPayWithCredit ? "balance" : (canPayHybrid ? "hybrid" : "zarinpal");
    string walletToggleHint = agencyBalance > 0
        ? $"موجودی کیف پول: {agencyBalance.ToString("N0")} تومان"
        : "موجودی کیف پول: ۰ تومان";

    Dictionary<int, string> monthName = new Dictionary<int, string>()
    {
    {1,"فروردین" },
    {2,"اردیبهشت"},
    {3, "خرداد"},
    {4, "تیر" },
    {5,"مرداد"},
    {6, "شهریور" },
    {7, "مهر" },
    {8, "آبان" },
    {9, "آذر" },
    {10, "دی" },
    {11, "بهمن" },
    {12, "اسفند" }
    };

}

