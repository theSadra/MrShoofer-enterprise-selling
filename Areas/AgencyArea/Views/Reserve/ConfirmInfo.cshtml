<script>
    function selectPm(method) {
        var hidden = document.getElementById('payment-method');
        if (hidden) hidden.value = method;
        document.querySelectorAll('.pm-pick').forEach(function (el) {
            if (!el.classList.contains('disabled')) el.classList.remove('selected');
        });
        var radio = document.getElementById(method === 'balance' ? 'pm-balance' : 'pm-zarinpal');
        if (radio) {
            radio.checked = true;
            var wrap = radio.closest('.pm-pick');
            if (wrap) wrap.classList.add('selected');
        }
        var btn = document.getElementById('confirm-pay-btn');
        if (btn) btn.textContent = method === 'zarinpal' ? 'پرداخت از درگاه' : 'تایید پرداخت از حساب';
    }

    function ChangeNumber() {
        var newPhoneNumber = document.getElementById('newnumberphone').value;

        document.getElementById('numberphone').value = newPhoneNumber;

        document.getElementById('numberphone_display').innerText = newPhoneNumber;

        var modal = bootstrap.Modal.getInstance(document.getElementById('modalCenter'));
        modal.hide();
    }
</script>
