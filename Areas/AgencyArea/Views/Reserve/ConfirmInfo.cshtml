                            <div class="pm-modal-copy">
                                <h3 class="modal-title" id="modalCenterTitle">تایید پرداخت</h3>
                                <small>صدور بلیط پس از پرداخت از حساب آژانس یا درگاه پرداخت</small>
                            </div>
                            <button aria-label="بستن" class="btn-close" data-bs-dismiss="modal" type="button"></button>
                        </div>
                    </div>
                    <div class="modal-body pb-1">
