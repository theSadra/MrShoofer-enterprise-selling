            </div>

            <div class="step-container selected">
                <div class="step">
                    <i class="ti ti-certificate ti-lg px-4 d:pb-4"></i>
                    <span class="pt-1 step-title ">
                        رزور و تایید
                    </span>
                </div>
                <div class="h-[0.063rem] flex-1  bg-divider"></div>
            </div>

            <div class="step-container">
                <div class="step">
                    <i class="ti ti-building-bank ti-lg px-4 d:pb-4 "></i>
                    <span class="pt-1 step-title">
                        پرداخت
                    </span>
                </div>
                <div class="h-[0.063rem] flex-1  bg-divider"></div>
            </div>

            <div class="step-container" style="flex: none;">
                <div class="step">
                    <i class="ti ti-ticket ti-lg px-4 d:pb-4"></i>
                    <span class="pt-1 step-title">
                        صدور
                    </span>
                </div>
            </div>
        </div>

    </div>

    <div class="downside-contaner mt-5 row">
        <div class="mb-4">

            <div class="d-flex justify-content-between align-items-baseline">
              <div>

                <h2 class="mb-2 font-bold" style="font-size: 1.5rem; line-height: 2rem; --tw-text-opacity: 1; color: rgb(41 38 61 / var(--tw-text-opacity));">تایید اطلاعات و رزرو</h2>
                <small>اطلاعات مسافر و سفر را تایید نهایی کنید</small>
              </div>

                <span onclick="window.history.back();">
                    بازگشت
                    <i class="ti ti-arrow-back-up"></i>
                </span>
            </div>

            
        </div>


        <div class="col-md-6 col-12">

            <div class="d-flex justify-content-start">


                <img class="d-inline" src="/taxiloc.png" height="47px" />

                <h4 class="ms-2 d-inline">سفر</h4>


            </div>
            <div class="card rounded-5 confirm-card col-12 mt-0">

                <div class="headline d-flex justify-content-between">
                    <span class="badge bg-dark rounded-pill py-2" style="font-size: .8rem!important">
                        @trip.taxiSupervisorName
                    </span>
                    <div class="capacity badge bg-label-secondary rounded-pill">
                        <i class="ti ti-armchair-2 d-inline"></i>
                        <small class="text-danger ms-1 d-inline t-bold">دربستی</small>
                    </div>
                </div>

                @{
                    var pdate = new Application.Services.PersianDate(trip.startingDateTime);
                    var models = (trip.carModelName ?? string.Empty).Split('|', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
                    string timeOfDay = trip.startingDateTime.Hour <= 11 ? "صبح"
                                     : trip.startingDateTime.Hour < 15 ? "ظهر"
                                     : trip.startingDateTime.Hour <= 19 ? "بعداز ظهر"
                                     : "شب";
                }

                @* مبدا و مقصد *@
                <div class="confirm-trip-route">
                    <span>
                        <small class="d-block mb-1 text-muted">
                            <img src="/redpin.png" height="16" alt="" />
                            مبدا
                        </small>
                        <span class="fs-6 text-blck fw-semibold d-block">@trip.originCityName</span>
                        <small class="text-muted">@trip.oringinLocationName</small>
                    </span>

                    <span class="route-mid" aria-hidden="true">
                        <span class="route-dots"></span>
                        <img src="/taxi.png" height="26" alt="" />
                        <span class="route-dots"></span>
                    </span>

                    <span>
                        <small class="d-block mb-1 text-muted">
                            <img src="/redpin.png" height="16" alt="" />
                            مقصد
                        </small>
                        <span class="fs-6 text-blck fw-semibold d-block">@trip.destinationCityName</span>
                        <small class="text-muted">@trip.destinationLocationName</small>
                    </span>
                </div>

                <hr />

                <div class="confirm-trip-meta">
                    <div class="confirm-meta-row">
                        <small><i class="ti ti-calendar-event me-1"></i>تاریخ سفر</small>
                        <span class="meta-value">@pdate.Day @monthName[pdate.Month] — @pdate.DayOfWeek</span>
                    </div>
                    <div class="confirm-meta-row">
                        <small><i class="ti ti-clock me-1"></i>ساعت حرکت</small>
                        <span class="meta-value">@trip.startingDateTime.ToString("HH:mm") <small class="text-muted">(@timeOfDay)</small></span>
                    </div>
                    <div class="confirm-meta-row">
                        <small>
                            <i class="ti ti-car me-1"></i>خودرو
                            @if (trip.taxiSupervisorID == 7)
                            {
                                <img src="/vip_badge.png" style="height:18px;vertical-align:middle" alt="" />
                            }
                        </small>
                        <span class="meta-value">
                            @foreach (var m in models)
                            {
                                <span class="badge bg-label-primary rounded-pill carmodel">@m</span>
                            }
                        </span>
                    </div>
                </div>

                <div class="confirm-feature-note">
                    <i class="ti ti-certificate-2" style="color:#000;font-size:1.05rem;flex-shrink:0" aria-hidden="true"></i>
                    <small>بلیط رسمی پس از تأیید پرداخت در سامانه مسترشوفر صادر و ثبت می‌گردد</small>
                </div>

                <div class="confirm-price-block">
                    <div class="confirm-price-row">
                        <div>
                            @if (ticketPrice != listPrice)
                            {
                                <h5>قیمت تمام شده</h5>
                                <small class="text-muted d-block mt-1">قیمت پیشنهادی فروش: @listPrice.ToString("N0") تومان</small>
                            }
                            else if (trip.afterdiscticketprice != trip.originalTicketprice && trip.originalTicketprice > 0)
                            {
                                <h5>قیمت بعد از تخفیف</h5>
                                <small class="text-muted d-block mt-1">قیمت قبل از تخفیف: @trip.originalTicketprice.ToString("N0") تومان</small>
                            }
                            else
                            {
                                <h5>قیمت تمام شده</h5>
                            }
                        </div>
                        <div class="price-stack">
                            @if (ticketPrice != listPrice)
                            {
                                <h5 class="mb-0 text-muted" style="font-size:0.9rem;font-weight:600;">
                                    <bdi>
                                        <svg class="toman" aria-hidden="true"><use xlink:href="#toman"></use></svg>@listPrice.ToString("N0")
                                    </bdi>
                                    <small class="ms-1" style="font-size:0.7rem;">پیشنهادی فروش</small>
                                </h5>
                            }
                            else if (trip.afterdiscticketprice != trip.originalTicketprice && trip.originalTicketprice > 0)
                            {
                                <h5 class="mb-0 text-muted" style="font-size:0.9rem;font-weight:600;">
                                    <bdi>
                                        <s><svg class="toman" aria-hidden="true"><use xlink:href="#toman"></use></svg>@trip.originalTicketprice.ToString("N0")</s>
                                    </bdi>
                                    <small class="ms-1" style="font-size:0.7rem;">قبل از تخفیف</small>
                                </h5>
                            }
                            <h4 class="price-final text-end">
                                <bdi>
                                    <svg class="toman" aria-hidden="true"><use xlink:href="#toman"></use></svg>@ticketPrice.ToString("N0")
                                </bdi>
                            </h4>
                        </div>
                    </div>
                    <p class="confirm-price-hint">
                        <i class="ti ti-info-circle ti-sm"></i>
                        @(ticketPrice != listPrice
                            ? "مبلغ پرداختی شما پس از کسر کمیسیون است؛ قیمت پیشنهادی فروش را می‌توانید از مسافر دریافت کنید"
                            : "قیمت درج‌شده مبلغ نهایی پرداخت شماست")
                    </p>
                </div>

                <svg width="0" height="0" class="d-none" aria-hidden="true">
                    <symbol id="toman" viewBox="0 0 14 14" xmlns="http://www.w3.org/2000/svg">
                        <path clip-rule="evenodd" fill-rule="evenodd" d="M3.057 1.742L3.821 1l.78.75-.776.741-.768-.749zm3.23 2.48c0 .622-.16 1.111-.478 1.467-.201.221-.462.39-.783.505a3.251 3.251 0 01-1.083.163h-.555c-.421 0-.801-.074-1.139-.223a2.045 2.045 0 01-.9-.738A2.238 2.238 0 011 4.148c0-.059.001-.117.004-.176.03-.55.204-1.158.525-1.827l1.095.484c-.257.532-.397 1-.419 1.403-.002.04-.004.08-.004.12 0 .252.055.458.166.618a.887.887 0 00.5.354c.085.028.178.048.278.06.079.01.16.014.243.014h.555c.458 0 .769-.081.933-.244.14-.139.21-.383.21-.731V2.02h1.2v2.202zm5.433 3.184l-.72-.7.709-.706.735.707-.724.7zm-2.856.308c.542 0 .973.19 1.293.569.297.346.445.777.445 1.293v.364h.18v-.004h.41c.221 0 .377-.028.467-.084.093-.055.14-.14.14-.258v-.069c.004-.243.017-1.044 0-1.115L13 8.05v1.574a1.4 1.4 0 01-.287.863c-.306.405-.804.607-1.495.607h-.627c-.061.733-.434 1.257-1.117 1.573-.267.122-.58.21-.937.265a5.845 5.845 0 01-.914.067v-1.159c.612 0 1.072-.082 1.38-.247.25-.132.376-.298.376-.499h-.515c-.436 0-.807-.113-1.113-.339-.367-.273-.55-.667-.55-1.18 0-.488.122-.901.367-1.24.296-.415.728-.622 1.296-.622zm.533 2.226v-.364c0-.217-.048-.389-.143-.516a.464.464 0 00-.39-.187.478.478 0 00-.396.187.705.705 0 00-.136.449.65.65 0 00.003.067c.008.125.066.22.177.283.093.054.21.08.352.08h.533zM9.5 6.707l.72.7.724-.7L10.209 6l-.709.707zm-6.694 4.888h.03c.433-.01.745-.106.937-.29.024.012.065.035.12.068l.074.039.081.042c.135.073.261.133.379.18.345.146.67.22.977.22a1.216 1.216 0 00.87-.34c.3-.285.449-.714.449-1.286a2.19 2.19 0 00-.335-1.145c-.299-.457-.732-.685-1.3-.685-.502 0-.916.192-1.242.575-.113.132-.21.284-.294.456-.032.062-.06.125-.084.191a.504.504 0 00-.03.078 1.67 1.67 0 00-.022.06c-.103.309-.171.485-.205.53-.072.09-.214.14-.427.147-.123-.005-.209-.03-.256-.076-.057-.054-.085-.153-.085-.297V7l-1.201-.5v3.562c0 .261.048.496.143.703.071.158.168.296.29.413.123.118.266.211.43.28.198.084.42.13.665.136v.001h.036zm2.752-1.014a.778.778 0 00.044-.353.868.868 0 00-.165-.47c-.1-.134-.217-.20