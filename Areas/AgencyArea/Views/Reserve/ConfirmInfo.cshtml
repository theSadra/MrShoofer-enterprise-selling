                                                <use xlink:href="#toman">
                                                    <symbol id="toman" viewBox="0 0 14 14" xmlns="http://www.w3.org/2000/svg">
                                                        <path clip-rule="evenodd" d="M3.057 1.742L3.821 1l.78.75-.776.741-.768-.749zm3.23 2.48c0 .622-.16 1.111-.478 1.467-.201.221-.462.39-.783.505a3.251 3.251 0 01-1.083.163h-.555c-.421 0-.801-.074-1.139-.223a2.045 2.045 0 01-.9-.738A2.238 2.238 0 011 4.148c0-.059.001-.117.004-.176.03-.55.204-1.158.525-1.827l1.095.484c-.257.532-.397 1-.419 1.403-.002.04-.004.08-.004.12 0 .252.055.458.166.618a.887.887 0 00.5.354c.085.028.178.048.278.06.079.01.16.014.243.014h.555c.458 0 .769-.081.933-.244.14-.139.21-.383.21-.731V2.02h1.2v2.202zm5.433 3.184l-.72-.7.709-.706.735.707-.724.7zm-2.856.308c.542 0 .973.19 1.293.569.297.346.445.777.445 1.293v.364h.18v-.004h.41c.221 0 .377-.028.467-.084.093-.055.14-.14.14-.258v-.069c.004-.243.017-1.044 0-1.115L13 8.05v1.574a1.4 1.4 0 01-.287.863c-.306.405-.804.607-1.495.607h-.627c-.061.733-.434 1.257-1.117 1.573-.267.122-.58.21-.937.265a5.845 5.845 0 01-.914.067v-1.159c.612 0 1.072-.082 1.38-.247.25-.132.376-.298.376-.499h-.515c-.436 0-.807-.113-1.113-.339-.367-.273-.55-.667-.55-1.18 0-.488.122-.901.367-1.24.296-.415.728-.622 1.296-.622zm.533 2.226v-.364c0-.217-.048-.389-.143-.516a.464.464 0 00-.39-.187.478.478 0 00-.396.187.705.705 0 00-.136.449.65.65 0 00.003.067c.008.125.066.22.177.283.093.054.21.08.352.08h.533zM9.5 6.707l.72.7.724-.7L10.209 6l-.709.707zm-6.694 4.888h.03c.433-.01.745-.106.937-.29.024.012.065.035.12.068l.074.039.081.042c.135.073.261.133.379.18.345.146.67.22.977.22a1.216 1.216 0 00.87-.34c.3-.285.449-.714.449-1.286a2.19 2.19 0 00-.335-1.145c-.299-.457-.732-.685-1.3-.685-.502 0-.916.192-1.242.575-.113.132-.21.284-.294.456-.032.062-.06.125-.084.191a.504.504 0 00-.03.078 1.67 1.67 0 00-.022.06c-.103.309-.171.485-.205.53-.072.09-.214.14-.427.147-.123-.005-.209-.03-.256-.076-.057-.054-.085-.153-.085-.297V7l-1.201-.5v3.562c0 .261.048.496.143.703.071.158.168.296.29.413.123.118.266.211.43.28.198.084.42.13.665.136v.001h.036zm2.752-1.014a.778.778 0 00.044-.353.868.868 0 00-.165-.47c-.1-.134-.217-.201-.35-.201-.18 0-.33.103-.447.31-.042.071-.08.158-.114.262a2.434 2.434 0 00-.04.12l-.015.053-.015.046c.142.118.323.216.544.293.18.062.325.092.433.092.044 0 .086-.05.125-.152z" fill-rule="evenodd"></path>
                                                    </symbol>
                                                </use>
                                            </svg>@ticketPrice.ToString("N0")
                                        </bdi>
                                    </h4>
                                </div>
                            </div>
                        </div>

                        <hr />

                        <div class="col-12 mt-2">
                            <div id="pm-wallet-toggle-row"
                                 class="pm-wallet-toggle @(walletToggleDefault ? "is-on" : "") @(!canUseWallet ? "is-disabled" : "")">
                                <div class="pm-wallet-toggle-copy">
                                    <strong>استفاده از موجودی کیف پول</strong>
                                    <small id="pm-wallet-hint">@walletToggleHint</small>
                                </div>
                                <div class="form-check form-switch m-0">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           role="switch"
                                           id="pm-wallet-toggle"
                                           @(walletToggleDefault ? "checked" : "")
                                           @(canUseWallet ? "" : "disabled")
                                           onchange="syncWalletPayment()" />
                                </div>
                            </div>

                            @{
                                int initialWalletApplied = walletToggleDefault
                                    ? (canPayWithCredit ? ticketPrice : (canPayHybrid ? agencyBalance : 0))
                                    : 0;
                                int initialGatewayPayable = Math.Max(0, ticketPrice - initialWalletApplied);
                            }
                            <div class="pm-invoice-summary" id="pm-invoice-summary">
                                <div class="pm-invoice-row">
                                    <span>قیمت نهایی</span>
                                    <strong dir="ltr">@ticketPrice.ToString("N0") تومان</strong>
                                </div>
                                <div class="pm-invoice-row" id="pm-wallet-row" style="@(initialWalletApplied > 0 ? "" : "display:none")">
                                    <span>کسر از کیف پول</span>
                                    <strong class="text-success" dir="ltr" id="pm-wallet-applied">−@initialWalletApplied.ToString("N0") تومان</strong>
                                </div>
                                <hr class="pm-invoice-divider" />
                                <div class="pm-invoice-row pm-invoice-row--payable">
                                    <span>قابل پرداخت <small class="text-muted">(درگاه)</small></span>
                                    <strong class="text-primary" dir="ltr" id="pm-gateway-payable">@initialGatewayPayable.ToString("N0") تومان</strong>
                                </div>
                            </div>
                        </div>

                        <div id="pm-summary-title" class="d-flex align-items-center w-100 mt-2 success-payment" style="height: 3.5rem !important;border-radius: 1.6rem !important;" role="status">
                            <span class="status-icon" aria-hidden="true">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                                    <polyline points="22 4 12 14.01 9 11.01"></polyline>
                                </svg>
                            </span>
                            <span>آماده پرداخت</span>
                        </div>

                    </div>

                    <div class="modal-footer d-flex justify-content-between mt-0">
                        <button class="btn btn-label-secondary p-3 px-3" data-bs-dismiss="modal" type="button"> بستن</button>



                        <form method="post" action="/Reserve/ConfirmInfo">
                            <input name="Tripcode" id="tripcode" type="hidden" value="@reserve_viemodel.TripCode" />
                            <input name="Firstname" id="firstname" type="hidden" value="@reserve_viemodel.Firstname" />
                            <input name="Lastname" id="lastname" type="hidden" value="@reserve_viemodel.Lastname" />
                            <input name="Numberphone" id="numberphone" type="hidden" value="@reserve_viemodel.NumebrPhone" />
                            <input name="Nacode" id="nacode" type="hidden" value="@reserve_viemodel.NaCode" />
                            <input name="Gender" id="gender" type="hidden" value="@reserve_viemodel.Gender" />
                            <input name="EmployeeId" id="employee-id" type="hidden" value="@(reserve_viemodel.EmployeeId?.ToString() ?? "")" />
                            <input name="HeadOfPassengers" id="head-of-passengers" type="hidden" value="@(reserve_viemodel.HeadOfPassengers ?? "")" />
                            <input name="CompanionsJson" id="companions-json" type="hidden" value="@Newtonsoft.Json.JsonConvert.SerializeObject(reserve_viemodel.Companions ?? new List<Application.ViewModels.Reserve.CompanionPassengerViewModel>())" />
                            <input name="PaymentMethod" id="payment-method" type="hidden" value="@defaultPm" />

                            <button class="btn btn-primary btn-lg" type="submit" id="confirm-pay-btn">
                                پرداخت
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

<div style="height: 10vh;">
</div>

<script>
    var pmTicketPrice = @ticketPrice;
    var pmAgencyBalance = @agencyBalance;

    function syncWalletPayment() {
        var toggle = document.getElementById('pm-wallet-toggle');
        var hidden = document.getElementById('payment-method');
        var row = document.getElementById('pm-wallet-toggle-row');
        var hint = document.getElementById('pm-wallet-hint');
        var walletRow = document.getElementById('pm-wallet-row');
        var walletAppliedEl = document.getElementById('pm-wallet-applied');
        var gatewayEl = document.getElementById('pm-gateway-payable');
        var useWallet = !!(toggle && toggle.checked && !toggle.disabled);

        var walletApplied = 0;
        var method = 'zarinpal';
        var hintText = 'موجودی کیف پول: ' + pmAgencyBalance.toLocaleString('en-US') + ' تومان';

        if (useWallet) {
            if (pmAgencyBalance >= pmTicketPrice) {
                method = 'balance';
                walletApplied = pmTicketPrice;
            } else if (pmAgencyBalance > 0) {
                method = 'hybrid';
                walletApplied = pmAgencyBalance;
            }
        }

        var gatewayPayable = Math.max(0, pmTicketPrice - walletApplied);

        if (hidden) hidden.value = method;
        if (row) row.classList.toggle('is-on', useWallet);
        if (hint) hint.textContent = hintText;
        if (walletRow) walletRow.style.display = walletApplied > 0 ? '' : 'none';
        if (walletAppliedEl) walletAppliedEl.textContent = '−' + walletApplied.toLocaleString('en-US') + ' تومان';
        if (gatewayEl) gatewayEl.textContent = gatewayPayable.toLocaleString('en-US') + ' تومان';
        var btn = document.getElementById('confirm-pay-btn');
        if (btn) btn.textContent = gatewayPayable === 0 ? 'پرداخت از کیف پول' : 'پرداخت از درگاه';
    }

    document.addEventListener('DOMContentLoaded', syncWalletPayment);

    function ChangeNumber() {
        var newPhoneNumber = document.getElementById('newnumberphone').value;

        document.getElementById('numberphone').value = newPhoneNumber;

        document.getElementById('numberphone_display').innerText = newPhoneNumber;

        var modal = bootstrap.Modal.getInstance(document.getElementById('modalCenter'));
        modal.hide();
    }
</script>
