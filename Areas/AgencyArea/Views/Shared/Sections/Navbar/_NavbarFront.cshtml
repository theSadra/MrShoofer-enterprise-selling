@{
	TempData.Keep();

	string? currentPage = ViewContext.HttpContext.Request.Path;
}

@using Application.Data
@using Application.Models
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject AppDbContext NavbarDb
@inject UserManager<IdentityUser> NavbarUserManager
@{
	var isOrganizationPanel = false;
	if (User?.Identity?.IsAuthenticated == true)
	{
		var uid = NavbarUserManager.GetUserId(User);
		if (!string.IsNullOrEmpty(uid))
		{
			isOrganizationPanel = NavbarDb.Agencies.AsNoTracking()
				.Any(a => a.IdentityUserId == uid && a.PanelType == AgencyPanelType.Organization);
		}
	}
}

<style>
	[dir=rtl] .dropdown-menu-end[data-bs-popper] {
		left: 0 !important;
		right: auto !important;
	}

	@@media (max-width: 767.98px) {
		.layout-navbar .navbar-nav .nav-item.dropdown .dropdown-menu {
			left: 0.9rem !important;
		}

		.navbar.landing-navbar {
			padding-inline: 0.85rem !important;
			padding-block: 0.45rem !important;
			margin-inline: 0.75rem;
			border-radius: 1.25rem;
		}

		.landing-navbar .navbar-brand {
			margin-inline-end: 0.65rem !important;
		}
	}

	/* Prevent contact/profile dropdown flash before front-palette.css loads */
	.landing-navbar .landing-nav-dropdown-menu:not(.show) {
		display: none !important;
	}

	/* Agency tools dropdown — keep under trigger, don't cover sibling nav links */
	@@media (min-width: 992px) {
		.landing-navbar .landing-nav-item-dropdown {
			position: relative;
		}

		.landing-navbar .landing-nav-item-dropdown .landing-nav-dropdown-menu.show {
			position: absolute !important;
			top: calc(100% + 0.4rem) !important;
			inset-inline-end: 0 !important;
			inset-inline-start: auto !important;
			transform: none !important;
			z-index: 1080;
		}
	}
</style>

<!-- Navbar: Start -->
<nav class="layout-navbar shadow-none py-0 d-block">
	<div class="container">
		<div class="navbar navbar-expand-lg landing-navbar px-3 px-md-4 shadow">
			<!-- Menu logo wrapper: Start -->
			<div class="navbar-brand app-brand demo d-flex align-items-center py-0 me-3 me-lg-4">
				@if (ViewData["isSideMenu"] is bool sideMenuOn && sideMenuOn)
				{
				<a href="javascript:void(0);" class="layout-menu-toggle menu-link text-large me-2 d-lg-none" aria-label="باز کردن منو">
					<i class="ti ti-menu-2 ti-sm align-middle"></i>
				</a>
				}
				else
				{
				<!-- Mobile menu toggle: Start-->
				<button class="navbar-toggler border-0 px-0 me-2" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
					<i class="ti ti-menu-2 ti-sm align-middle"></i>
				</button>
				<!-- Mobile menu toggle: End-->
				}
				<a asp-controller="Home" asp-action="Index" class="app-brand-link">
					<span class="app-brand-logo demo" style="width:unset; height: unset;">
						<img src="~/logo_full_b.png" height="32" alt="مسترشوفر" />
					</span>
				</a>
			</div>
			<!-- Menu logo wrapper: End -->
			<!-- Menu wrapper: Start -->
			@{
				var hideLandingLinks = ViewData["isSideMenu"] is bool hideNav && hideNav;
			}
			<div class="collapse navbar-collapse landing-nav-menu @(hideLandingLinks ? "d-none" : null)" id="navbarSupportedContent">
				<button class="navbar-toggler border-0 text-heading position-absolute end-0 top-0 scaleX-n1-rtl" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="بستن منو">
					<iconify-icon class="navbar-close-icon" icon="fluent:dismiss-24" width="23" height="23" aria-hidden="true"></iconify-icon>
				</button>
				@{
					var path = (currentPage ?? "").ToLowerInvariant();
					var agencyToolsActive =
						path.Contains("/agencyarea/agency")
						|| path.Contains("/agencyarea/officialinvoices")
						|| path.Contains("/agencyarea/employees");
				}
				<ul class="navbar-nav me-auto p-3 p-lg-0 align-items-lg-center flex-lg-nowrap">

					<li class="nav-item">
						<a class="fw-medium btn btn-sm btn-primary navbar-nav-btn navbar-newtrip-btn" asp-area="AgencyArea" asp-controller="Home" asp-action="Index">
							<span>
								<i class="ti ti-ticket"></i>
								سفر جدید
							</span>
						</a>
					</li>

					<li class="nav-item">
						<a class="nav-link fw-medium" asp-area="AgencyArea" asp-controller="TicketInfo" asp-action="Index">
							<span><i class="ti ti-certificate-2"></i> بلیط‌ ها</span>
						</a>
					</li>

					<li class="nav-item dropdown landing-nav-item-dropdown">
						<a class="nav-link fw-medium dropdown-toggle @(agencyToolsActive ? "active" : null)" href="javascript:void(0);" data-bs-toggle="dropdown" data-bs-display="static" data-bs-auto-close="outside" aria-expanded="false">
							<span><i class="ti ti-building-store"></i> خدمات آژانس</span>
						</a>
						<ul class="dropdown-menu landing-nav-dropdown-menu dropdown-menu-end">
							<li>
								<a class="dropdown-item navbar-nav-btn" asp-area="AgencyArea" asp-controller="Agency" asp-action="Index">
									<span><i class="ti ti-home"></i> پروفایل آژانس</span>
								</a>
							</li>
							<li>
								<a class="dropdown-item navbar-nav-btn" asp-area="AgencyArea" asp-controller="OfficialInvoices" asp-action="Index">
									<span><i class="ti ti-file-invoice"></i> فاکتور رسمی</span>
								</a>
							</li>
							<li>
								<a class="dropdown-item navbar-nav-btn" asp-area="AgencyArea" asp-controller="Employees" asp-action="Index">
									<span><i class="ti ti-users"></i> @(isOrganizationPanel ? "اعضای سازمان" : "مسافرین")</span>
								</a>
							</li>
							<li>
								<a class="dropdown-item navbar-nav-btn" href="/Analytics">
									<span><i class="ti ti-chart-bar"></i> گزارشات</span>
								</a>
							</li>
							@if (isOrganizationPanel)
							{
							<li>
								<a class="dropdown-item navbar-nav-btn" asp-area="AgencyArea" asp-controller="Agency" asp-action="Index" asp-fragment="financial">
									<span><i class="ti ti-id"></i> اطلاعات حقوقی</span>
								</a>
							</li>
							}
						</ul>
					</li>

					<li class="nav-item">
						<a class="nav-link fw-medium" href="javascript:void(0);" data-bs-toggle="modal" data-bs-target="#agencySupportModal">
							<span><i class="ti ti-heart-handshake"></i> پشتیبانی</span>
						</a>
					</li>
				</ul>
			</div>
			<div class="landing-menu-overlay d-lg-none"></div>
			<!-- Menu wrapper: End -->
			<!-- Toolbar: Start -->
			<ul class="navbar-nav flex-row align-items-center ms-auto">

				<!-- Style Switcher -->
				@* <li class="nav-item dropdown-style-switcher dropdown me-2 me-xl-0">
				<a class="nav-link dropdown-toggle hide-arrow" href="javascript:void(0);" data-bs-toggle="dropdown">
				<i class='ti ti-sm'></i>
				</a>
				<ul class="dropdown-menu dropdown-menu-end dropdown-styles">
				<li>
				<a class="dropdown-item" href="javascript:void(0);" data-theme="light">
				<span class="align-middle"><i class='ti ti-sun me-2'></i>روز</span>
				</a>
				</li>
				<li>
				<a class="dropdown-item" href="javascript:void(0);" data-theme="dark">
				<span class="align-middle"><i class="ti ti-moon me-2"></i>شب</span>
				</a>
				</li>
				<li>
				<a class="dropdown-item" href="javascript:void(0);" data-theme="system">
				<span class="align-middle"><i class="ti ti-device-desktop me-2"></i>سیستم</span>
				</a>
				</li>
				</ul>
				</li> *@
				<!-- / Style Switcher-->
				<!-- navbar button: Start -->
				@{
						if (User.Identity.IsAuthenticated)

						{
						<li class="nav-item navbar-dropdown dropdown-user dropdown">
							<a class="nav-link dropdown-toggle hide-arrow d-flex align-items-center" data-bs-toggle="dropdown" href="javascript:void(0);" aria-expanded="false" aria-label="منوی حساب آژانس">
								<span class="navbar-agency-avatar" aria-hidden="true">
									<iconify-icon icon="fluent-color:building-24" width="26" height="26"></iconify-icon>
								</span>
							</a>
							<ul class="dropdown-menu dropdown-menu-end">

								<li>
									<a class="dropdown-item" asp-area="AgencyArea" asp-controller="Agency" asp-action="Index">
										<iconify-icon class="fc-icon me-2" icon="fluent-color:person-available-24" width="18" height="18" aria-hidden="true"></iconify-icon>
										<span class="align-middle">پروفایل آژانس</span>
									</a>
								</li>
								<li>
									<a class="dropdown-item" asp-area="AgencyArea" asp-controller="TicketInfo" asp-action="Index">
										<span class="d-flex align-items-center align-middle">
											<iconify-icon class="fc-icon flex-shrink-0 me-2" icon="fluent-color:receipt-24" width="18" height="18" aria-hidden="true"></iconify-icon>
											<span class="flex-grow-1 align-middle">خریدها</span>
										</span>
									</a>
								</li>
								<li>
									<a class="dropdown-item" asp-area="AgencyArea" asp-controller="OfficialInvoices" asp-action="Index">
										<span class="d-flex align-items-center align-middle">
											<iconify-icon class="fc-icon flex-shrink-0 me-2" icon="fluent-color:document-text-24" width="18" height="18" aria-hidden="true"></iconify-icon>
											<span class="flex-grow-1 align-middle">فاکتور رسمی</span>
										</span>
									</a>
								</li>
								<li>
									<a class="dropdown-item" asp-area="AgencyArea" asp-controller="Employees" asp-action="Index">
										<span class="d-flex align-items-center align-middle">
											<iconify-icon class="fc-icon flex-shrink-0 me-2" icon="fluent-color:people-24" width="18" height="18" aria-hidden="true"></iconify-icon>
											<span class="flex-grow-1 align-middle">@(isOrganizationPanel ? "اعضای سازمان" : "مسافرین")</span>
										</span>
									</a>
								</li>
								<li>
									<a class="dropdown-item" href="/Analytics">
										<span class="d-flex align-items-center align-middle">
											<iconify-icon class="fc-icon flex-shrink-0 me-2" icon="fluent-color:chart-multiple-24" width="18" height="18" aria-hidden="true"></iconify-icon>
											<span class="flex-grow-1 align-middle">گزارشات</span>
										</span>
									</a>
								</li>
								@if (isOrganizationPanel)
								{
								<li>
									<a class="dropdown-item" asp-area="AgencyArea" asp-controller="Agency" asp-action="Index" asp-fragment="financial">
										<span class="d-flex align-items-center align-middle">
											<iconify-icon class="fc-icon flex-shrink-0 me-2" icon="fluent-color:contact-card-24" width="18" height="18" aria-hidden="true"></iconify-icon>
											<span class="flex-grow-1 align-middle">اطلاعات حقوقی</span>
										</span>
									</a>
								</li>
								}
								<li>
									<a class="dropdown-item" asp-area="AgencyArea" asp-controller="Agency" asp-action="Index" asp-fragment="balance">
										<iconify-icon class="fc-icon me-2" icon="fluent-color:coin-multiple-24" width="18" height="18" aria-hidden="true"></iconify-icon>
										<span class="align-middle">شارژ حساب</span>
									</a>
								</li>
								<li>
									<a class="dropdown-item" asp-area="AgencyArea" asp-controller="Agency" asp-action="Index">
										<iconify-icon class="fc-icon me-2" icon="fluent-color:settings-24" width="18" height="18" aria-hidden="true"></iconify-icon>
										<span class="align-middle">تنظیمات / پروفایل</span>
									</a>
								</li>

								<li>
									<div class="dropdown-divider"></div>
								</li>


								<li>
									<a class="dropdown-item" href="javascript:void(0);" data-bs-toggle="modal" data-bs-target="#agencySupportModal">
										<span class="d-flex align-items-center align-middle">
											<iconify-icon class="fc-icon flex-shrink-0 me-2" icon="fluent-color:person-feedback-24" width="18" height="18" aria-hidden="true"></iconify-icon>
											<span class="flex-grow-1 align-middle">درخواست پیگیری</span>
										</span>
									</a>
								</li>

								<li>
									<div class="dropdown-divider"></div>
								</li>
								<li>
									<a class="dropdown-item" asp-area="AgencyArea" asp-controller="Auth" asp-action="Logout">
										<iconify-icon class="fc-icon me-2" icon="fluent-color:lock-closed-24" width="18" height="18" aria-hidden="true"></iconify-icon>
										<span class="align-middle text-danger">خروج از حساب</span>
									</a>
								</li>
							</ul>
						</li>

						}

						else

						{
						<li class="nav-item">
							<a asp-area="AgencyArea" asp-controller="Auth" asp-action="Login" class="btn btn-primary"><span class="tf-icons ti ti-login scaleX-n1-rtl me-md-1"></span><span class="d-none d-md-block">ورود / ثبت نام</span></a>
						</li>
						}
					}

				<!-- navbar button: End -->
			</ul>
		</div>
	</div>
</nav>
