@model List<Application.Models.AgencyEmployee>
@{
	ViewData["Title"] = "مسافرین پرتردد";
	Layout = "_AgencySideLayout";
	var search = ViewBag.Search as string ?? "";
}

<div class="main_container px-lg-6 px-0 pb-5" dir="rtl">
	<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
		<div>
			<h4 class="mb-1 text-blck">مسافرین پرتردد</h4>
			<small class="text-muted">دفترچه مسافران برای رزرو سریع‌تر</small>
		</div>
		<a class="btn btn-primary" asp-action="Create">
			<i class="ti ti-plus me-1"></i>
			افزودن مسافر
		</a>
	</div>

	@if (TempData["SuccessMessage"] != null)
	{
		<div class="alert alert-success rounded-4">@TempData["SuccessMessage"]</div>
	}

	<div class="bg-white rounded-5 border border-divider shadow-7.5__13__5__gray30 p-3 mb-3">
		<form method="get" class="row g-2 align-items-end">
			<div class="col-md-8">
				<label class="form-label mb-1">جستجو</label>
				<input type="search" name="q" value="@search" class="form-control" placeholder="نام، کد ملی، موبایل یا ایمیل" autocomplete="off" />
			</div>
			<div class="col-md-4 d-flex gap-2">
				<button type="submit" class="btn btn-primary flex-grow-1">فیلتر</button>
				@if (!string.IsNullOrWhiteSpace(search))
				{
					<a class="btn btn-outline-secondary" asp-action="Index">پاک کردن</a>
				}
			</div>
		</form>
	</div>

	<div class="bg-white rounded-5 border border-divider shadow-7.5__13__5__gray30 p-0 overflow-hidden">
		<div class="table-responsive">
			<table class="table table-hover align-middle mb-0">
				<thead>
					<tr>
						<th class="ps-3">نام</th>
						<th>نام خانوادگی</th>
						<th>جنسیت</th>
						<th>کد ملی</th>
						<th>موبایل</th>
						<th>ایمیل</th>
						<th class="text-end pe-3">عملیات</th>
					</tr>
				</thead>
				<tbody>
					@if (Model == null || Model.Count == 0)
					{
						<tr>
							<td colspan="7" class="text-center text-muted py-5">هنوز مسافری ثبت نشده است</td>
						</tr>
					}
					else
					{
						foreach (var e in Model)
						{
							<tr>
								<td class="ps-3">@e.Firstname</td>
								<td>@e.Lastname</td>
								<td>@(e.Gender == "female" || e.Gender == "Female" ? "خانم" : "آقا")</td>
								<td dir="ltr">@e.NaCode</td>
								<td dir="ltr">@e.PhoneNumber</td>
								<td>@(e.Email ?? "—")</td>
								<td class="text-end pe-3">
									<div class="d-flex flex-wrap gap-1 justify-content-end">
										<a class="btn btn-sm btn-outline-secondary" asp-action="Trips" asp-route-id="@e.Id">سفرها</a>
										<a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@e.Id">ویرایش</a>
										<form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('حذف این مسافر؟');">
											@Html.AntiForgeryToken()
											<input type="hidden" name="id" value="@e.Id" />
											<button type="submit" class="btn btn-sm btn-outline-danger">حذف</button>
										</form>
									</div>
								</td>
							</tr>
						}
					}
				</tbody>
			</table>
		</div>
	</div>
</div>
