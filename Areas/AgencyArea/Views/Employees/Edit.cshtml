@model Application.ViewModels.Employees.AgencyEmployeeFormViewModel
@{
	var pageTitle = ViewBag.PageTitle as string ?? "ویرایش";
	ViewData["Title"] = pageTitle;
	Layout = "_AgencySideLayout";
	var entityLabel = ViewBag.EntityLabel as string ?? "فرد";
	var isOrganization = ViewBag.IsOrganization as bool? == true;
}

@section PageStyles {
	<link rel="stylesheet" href="~/css/agency-users.css" asp-append-version="true" />
}

<div class="agency-users container-xxl flex-grow-1 container-p-y" dir="rtl">
	<div class="agency-users__head">
		<div>
			<h1 class="agency-users__title">@pageTitle</h1>
			<p class="agency-users__subtitle">اطلاعات @entityLabel برای رزرو و فاکتور سریع‌تر ذخیره می‌شود.</p>
		</div>
		<a class="agency-users__btn agency-users__btn--ghost" asp-action="Index">بازگشت به فهرست</a>
	</div>

	<div class="agency-users-form">
		<form asp-action="Edit" method="post">
			@Html.AntiForgeryToken()
			<input type="hidden" asp-for="Id" />
			<div class="row g-3">
				<div class="col-md-6">
					<label asp-for="Firstname" class="form-label">نام</label>
					<input asp-for="Firstname" class="form-control" autocomplete="off" />
					<span asp-validation-for="Firstname" class="text-danger"></span>
				</div>
				<div class="col-md-6">
					<label asp-for="Lastname" class="form-label">نام خانوادگی</label>
					<input asp-for="Lastname" class="form-control" autocomplete="off" />
					<span asp-validation-for="Lastname" class="text-danger"></span>
				</div>
				<div class="col-md-6">
					<label asp-for="Gender" class="form-label">جنسیت</label>
					<select asp-for="Gender" class="form-select">
						<option value="">انتخاب کنید</option>
						<option value="male">آقا</option>
						<option value="female">خانم</option>
					</select>
					<span asp-validation-for="Gender" class="text-danger"></span>
				</div>
				<div class="col-md-6">
					<label asp-for="NaCode" class="form-label">کد ملی</label>
					<input asp-for="NaCode" class="form-control" maxlength="10" autocomplete="off" dir="ltr" />
					<span asp-validation-for="NaCode" class="text-danger"></span>
				</div>
				<div class="col-md-6">
					<label asp-for="PhoneNumber" class="form-label">شماره موبایل</label>
					<input asp-for="PhoneNumber" class="form-control" autocomplete="off" dir="ltr" />
					<span asp-validation-for="PhoneNumber" class="text-danger"></span>
				</div>
				<div class="col-md-6">
					<label asp-for="Email" class="form-label">ایمیل</label>
					<input asp-for="Email" class="form-control" autocomplete="off" dir="ltr" placeholder="اختیاری" />
					<span asp-validation-for="Email" class="text-danger"></span>
				</div>
				@if (isOrganization)
				{
				<div class="col-12">
					<label asp-for="InternalTitle" class="form-label">سمت / نقش درون سازمانی <span class="text-muted fw-normal">(اختیاری)</span></label>
					<input asp-for="InternalTitle" class="form-control" list="orgRolePresets" maxlength="120" autocomplete="off" placeholder="انتخاب یا ایجاد نقش جدید" />
					<datalist id="orgRolePresets">
						<option value="مدیرعامل (CEO)"></option>
						<option value="مدیر"></option>
						<option value="کارمند"></option>
						<option value="کارشناس"></option>
						<option value="حسابدار"></option>
						<option value="منشی"></option>
					</datalist>
					<small class="text-muted">می‌توانید از نقش‌های پیش‌فرض انتخاب کنید یا نقش جدید بنویسید.</small>
					<span asp-validation-for="InternalTitle" class="text-danger"></span>
				</div>
				}
			</div>
			<div class="agency-users-form__actions">
				<button type="submit" class="agency-users__btn agency-users__btn--primary">ذخیره تغییرات</button>
				<a class="agency-users__btn agency-users__btn--ghost" asp-action="Index">انصراف</a>
			</div>
		</form>
	</div>
</div>
