@model List<Application.Models.Ticket>
@using Application.Services
@{
	var employee = (Application.Models.AgencyEmployee)ViewBag.Employee;
	ViewData["Title"] = $"سفرهای {employee.Firstname} {employee.Lastname}";
	Layout = "_AgencySideLayout";
	var fromShamsi = ViewBag.FromShamsi as string ?? "";
	var toShamsi = ViewBag.ToShamsi as string ?? "";
}

<div class="main_container px-lg-6 px-0 pb-5" dir="rtl">
	<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
		<div>
			<h4 class="mb-1 text-blck">سفرهای @employee.Firstname @employee.Lastname</h4>
			<small class="text-muted">کد ملی @employee.NaCode · @employee.PhoneNumber</small>
		</div>
		<a class="btn btn-outline-secondary" asp-action="Index">بازگشت به لیست</a>
	</div>

	<div class="bg-white rounded-5 border border-divider shadow-7.5__13__5__gray30 p-3 mb-3">
		<form method="get" asp-action="Trips" asp-route-id="@employee.Id" class="row g-2 align-items-end">
			<div class="col-md-4">
				<label class="form-label mb-1">از تاریخ شمسی</label>
				<input type="text" name="from" value="@fromShamsi" class="form-control" dir="ltr" placeholder="1404/01/01" />
			</div>
			<div class="col-md-4">
				<label class="form-label mb-1">تا تاریخ شمسی</label>
				<input type="text" name="to" value="@toShamsi" class="form-control" dir="ltr" placeholder="1404/12/29" />
			</div>
			<div class="col-md-4 d-flex gap-2">
				<button type="submit" class="btn btn-primary flex-grow-1">اعمال فیلتر</button>
			</div>
		</form>
	</div>

	<div class="bg-white rounded-5 border border-divider shadow-7.5__13__5__gray30 p-0 overflow-hidden">
		<div class="table-responsive">
			<table class="table table-hover align-middle mb-0">
				<thead>
					<tr>
						<th class="ps-3">کد بلیط</th>
						<th>مسیر</th>
						<th>تاریخ ثبت</th>
						<th>مبلغ (تومان)</th>
						<th class="pe-3">وضعیت</th>
					</tr>
				</thead>
				<tbody>
					@if (Model == null || Model.Count == 0)
					{
						<tr>
							<td colspan="5" class="text-center text-muted py-5">در این بازه سفری برای این مسافر ثبت نشده است</td>
						</tr>
					}
					else
					{
						foreach (var t in Model)
						{
							var companions = t.Companions?.OrderBy(c => c.SortOrder).ToList() ?? new List<Application.Models.TicketCompanion>();
							var pdate = t.RegisteredAt.ToPersianDate();
							<tr>
								<td class="ps-3">@t.TicketCode</td>
								<td>
									@t.TripOrigin → @t.TripDestination
									@if (companions.Count > 0)
									{
										<div class="small text-muted mt-1">
											همراهان:
											@string.Join("، ", companions.Select(c => c.Firstname + " " + c.Lastname))
										</div>
									}
								</td>
								<td dir="ltr">@($"{pdate.Year}/{pdate.Month:00}/{pdate.Day:00} {t.RegisteredAt:HH:mm}")</td>
								<td>@t.TicketFinalPrice.ToString("N0")</td>
								<td class="pe-3">@(t.IsCancelled ? "لغو شده" : "صادر شده")</td>
							</tr>
						}
					}
				</tbody>
			</table>
		</div>
	</div>
</div>
