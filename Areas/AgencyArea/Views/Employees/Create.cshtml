@model Application.ViewModels.Employees.AgencyEmployeeFormViewModel
@{
	ViewData["Title"] = "افزودن مسافر";
	Layout = "_AgencySideLayout";
}

<div class="main_container px-lg-6 px-0 pb-5" dir="rtl">
	<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
		<h4 class="mb-0 text-blck">افزودن مسافر پرتردد</h4>
		<a class="btn btn-outline-secondary" asp-action="Index">بازگشت</a>
	</div>

	<div class="bg-white rounded-5 border border-divider shadow-7.5__13__5__gray30 p-3 p-md-4">
		<form asp-action="Create" method="post">
			@Html.AntiForgeryToken()
			<div class="row g-3">
				<div class="col-md-6">
					<label asp-for="Firstname" class="form-label">نام</label>
					<input asp-for="Firstname" class="form-control" autocomplete="off" />
					<span asp-validation-for="Firstname" class="text-danger"></span>
				</div>
				<div class="col-md-6">
					<label asp-for="Lastname" class="form-label">نام خانوادگی</label>
					<input asp-for="Lastname" class="form-control" autocomplete="off" />
					<span asp-validation-for="Lastname" class="text-danger"></span>
				</div>
				<div class="col-md-6">
					<label asp-for="Gender" class="form-label">جنسیت</label>
					<select asp-for="Gender" class="form-select">
						<option value="">انتخاب کنید</option>
						<option value="male">آقا</option>
						<option value="female">خانم</option>
					</select>
					<span asp-validation-for="Gender" class="text-danger"></span>
				</div>
				<div class="col-md-6">
					<label asp-for="NaCode" class="form-label">کد ملی</label>
					<input asp-for="NaCode" class="form-control" maxlength="10" autocomplete="off" dir="ltr" />
					<span asp-validation-for="NaCode" class="text-danger"></span>
				</div>
				<div class="col-md-6">
					<label asp-for="PhoneNumber" class="form-label">شماره موبایل</label>
					<input asp-for="PhoneNumber" class="form-control" autocomplete="off" dir="ltr" />
					<span asp-validation-for="PhoneNumber" class="text-danger"></span>
				</div>
				<div class="col-md-6">
					<label asp-for="Email" class="form-label">ایمیل (اختیاری)</label>
					<input asp-for="Email" class="form-control" autocomplete="off" dir="ltr" />
					<span asp-validation-for="Email" class="text-danger"></span>
				</div>
			</div>
			<div class="mt-4">
				<button type="submit" class="btn btn-primary btn-lg px-4" style="border-radius: 1.6rem;">ذخیره</button>
			</div>
		</form>
	</div>
</div>
