@model List<Application.Services.MrShooferORS.SearchedTrip>
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@{

    Layout = "_FrontLayout";

    ViewData["title"] = "جستجوی سواری";
}



@section PageStyles{

}

@section VendorStyles {
    <link href="~/vendor/css/pages/front-page-landing.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/jalali-datepicker.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/trip-search.css" asp-append-version="true" />
	<link href="~/css/TaxiTripsIndex.css" rel="stylesheet" asp-append-version="true" />
    <link rel="stylesheet" href="~/vendor/libs/spinkit/spinkit.css">
}
@section VendorScripts {
    <script src="~/libs/jquery.js"></script>
    <script src="~/vendor/libs/jdate/jdate.min.js" asp-append-version="true"></script>
    <script src="~/js/jalali-datepicker.js" asp-append-version="true"></script>
    <script src="~/vendor/js/dropdown-hover.js"></script>
}
@section PageScripts {
    <script src="~/js/cards-actions.js"></script>
    <script src="~/js/front-page-landing.js"></script>
    <script src="~/js/searchpage.js" asp-append-version="true"></script>
	<script src="~/js/IndexPage.js" asp-append-version="true"></script>
	<script>
		window.ORS_API_BASE = '@(Configuration["MrShoofer:ApiBaseUrl"] ?? Configuration["serivce_url"] ?? "https://ors.shoofer.taxi")'.replace(/\/$/, '');
	</script>
	<script src="~/js/Trips.js" asp-append-version="true"></script>
	<script>
	(function () {
		var rail = document.getElementById('tripsTimelineRail');
		if (!rail) return;
		document.querySelectorAll('.switchbar-container .scroll_button').forEach(function (btn) {
			btn.addEventListener('click', function () {
				var dir = btn.getAttribute('data-scroll-dir') === 'end' ? 1 : -1;
				// RTL: "start" (right chevron) scrolls toward start of content
				var delta = Math.max(160, Math.floor(rail.clientWidth * 0.7)) * dir;
				rail.scrollBy({ left: delta, behavior: 'smooth' });
			});
		});
	})();
	</script>



}

<style>
    .daytext {
        text-align: center;
    }

    .tripday {
        align-items: stretch;
        border-radius: 8px !important;
        cursor: pointer;
        display: flex;
        flex-direction: column;
        flex-shrink: 0;
        justify-content: center;
        margin: 0 6px;
        padding: 0 4px;
        position: relative;
        -webkit-user-select: none;
        -moz-user-select: none;
        user-select: none;
        /* width: 88px; */
    }

    .switchbar-container {
        display: flex;
        align-items: center;
        display: flex;
        max-width: 100%;
        flex-direction: row !important;
    }

    .scroll_button {
        padding: 8px;
        width: 48px;
    }

    .timelline-container {
        align-items: center;
        display: flex;
        overflow-x: scroll;
        overflow-y: hidden;
        padding-bottom: 8px;
        scrollbar-width: none;
        display: flex;
    }

    .scroll_button {
        background: none;
        border: none;
        color: inherit;
        cursor: pointer;
        outline: none;
        align-self: stretch;
    }
</style>
<style>


    @@media only screen and (min-width: 960px) {
        .px-lg-6 {
            padding-right: 2.6rem !important;
            padding-left: 2.6rem !important;
        }
    }

    @@media only screen and (min-width: 1200px) {
        .px-lg-6 {
            padding-right: 8rem !important;
            padding-left: 8rem !important;
        }
    }

</style>
<style>
    .submitation {
        max-width: 300px;
        min-width: 220px;
        flex: 0 0 auto;
        flex-direction: column;
        justify-content: center;
        gap: 0.5rem;
    }

    .transport {
        flex-grow: 3;
        max-width: 300px;
        margin-right: 3.6rem;
    }

    .trip-info {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: stretch;
        gap: 1rem;
        margin-inline-start: 0;
    }

    .trip-info-main {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1rem;
        flex: 1 1 auto;
        min-width: 0;
    }

    .startendtime {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.35rem;
        flex-wrap: nowrap;
    }

    .starttime-badge {
        border-radius: 0.45rem !important;
        color: #18181b;
        padding: 0.35rem 0.55rem;
    }

    .trip-route-line {
        display: inline-flex;
        align-items: center;
        gap: 0.15rem;
        color: #a1a1aa;
        flex: 1 1 auto;
        justify-content: center;
        min-width: 2.5rem;
    }

    .trip-route-dots {
        letter-spacing: 0.05em;
        font-size: 0.75rem;
        line-height: 1;
    }

    .endtime-wrap {
        display: inline-flex;
        align-items: baseline;
        gap: 0.2rem;
        white-space: nowrap;
    }

    .endtime-approx {
        font-size: 0.65rem !important;
    }

    .direction {
        display: flex;
        justify-content: space-between;
        gap: 0.75rem;
    }

    .fa-taxiSide {
        height: 1.2em;
        width: 1.2em;
    }

    .price {
        color: #18181b;
        font-size: 1.125rem;
        font-style: normal;
        font-variation-settings: "wght" 700;
        font-weight: 700;
        text-align: right;
    }

    .orgprice {
        color: #18181b;
        font-size: 0.95rem;
        font-style: normal;
        font-variation-settings: "wght" 600;
        font-weight: 600;
        text-align: right;
        text-decoration: none;
    }

    .orgprice--struck,
    .orgprice--struck .trip-price-num,
    .orgprice--struck .trip-price-currency {
        color: #a1a1aa !important;
        font-size: 0.78rem !important;
        font-weight: 500 !important;
        text-decoration: line-through !important;
    }

    .logo-image {
        height: 58px;
        width: auto;
        -o-object-fit: contain;
        object-fit: contain;
        background: transparent !important;
        mix-blend-mode: multiply;
    }

    .leftside {
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .directionval {
        font-weight: 400;
        font-size: 14px;
        font-style: normal;
        font-variation-settings: "wght" 400;
        line-height: 1.45;
        min-width: 0;
    }

    .mainbody {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        width: 100%;
    }

    .provider {
        text-align: center;
        flex: 0 0 auto;
    }

    .trip-service-name {
        font-size: 1rem;
        font-weight: 700;
    }

    .starttime, .endtime {
        font-size: 1.7rem;
        color: #18181b;
        font-weight: 700;
        line-height: 1.1;
    }

    .tripcardheader {
        display: flex;
        justify-content: space-between;
        align-items: start;
    }

    .carmodel {
        color: black !important;
        max-width: 14rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .direction-container {
        display: flex;
        flex-direction: column;
        justify-content: start;
        gap: 0.35rem;
        min-width: 0;
    }

	.trips-page-shell .landing-hero,
	.trips-page-shell .trips-results {
		background: transparent !important;
		background-image: none !important;
		border-radius: 0 !important;
		margin-inline: 0 !important;
	}

	.trips-page-shell .landing-hero::before,
	.trips-page-shell .landing-hero::after {
		display: none !important;
		content: none !important;
	}
</style>


<div class="trips-page-shell">

<div class="landing-hero trips-search-hero px-lg-5 px-0 pb-md-3">
	<div class="container px-lg-6 px-0">

	<div class="searchbar card shadow">
		<form asp-controller="TaxiTrips" method="get" asp-action="Index" id="tripForm"
			  class="searchbar-form"
			  data-initial-origin="@(ViewBag.origin_city_text as string ?? "")"
			  data-initial-dest="@(ViewBag.dest_city_text as string ?? "")">
			<div class="card-body searchbar-body">
				@* OTA rail: origin | swap | destination | date | search — one horizontal unit *@
				<div class="searchbar-rail">
					<div class="od-pair-col">
						<div class="od-pair">
							<div class="inputcel">
								<small class="searchbar-field-label">مبدا</small>
								<div class="input-container">
									<input required id="origin_input" name="originstring" autocomplete="off" value="@ViewBag.origin_city_text" data-bs-toggle="dropdown" class="form-control origin input-field dropdown-toggle hide-arrow" placeholder="مبدا" type="text" role="combobox" aria-expanded="false" style="font-weight:bold;" />
									<i class="ti ti-location icon" aria-hidden="true"></i>
									<div class="dropdown-menu dropdown-menu-end origin_location"></div>
								</div>
							</div>

							<div class="inputcel">
								<small class="searchbar-field-label">مقصد</small>
								<div class="input-container">
									<input required id="destination_input" name="destinationstring" value="@ViewBag.dest_city_text" data-bs-toggle="dropdown" autocomplete="off" class="form-control destination input-field dropdown-toggle hide-arrow" placeholder="مقصد" type="text" role="combobox" aria-expanded="false" style="font-weight:bold;" />
									<i class="ti ti-map-pin icon" aria-hidden="true"></i>
									<div class="dropdown-menu dropdown-menu-end destination_location"></div>
								</div>
							</div>
						</div>
						<button type="button" class="od-swap-btn" id="od-swap-btn" title="جابه‌جایی مبدأ و مقصد" aria-label="جابه‌جایی مبدأ و مقصد">
							<i class="ti ti-arrows-left-right" aria-hidden="true"></i>
						</button>
					</div>

					<div class="inputcel searchbar-date">
						<small class="searchbar-field-label">تاریخ سفر</small>
						<div class="input-container">
							<input required name="searchdate" autocomplete="off" value="@ViewBag.searchdate" class="form-control bdi starttimeselector" id="starttime" placeholder="تاریخ سفر" type="text" />
							<i class="ti ti-calendar-stats icon" aria-hidden="true"></i>
						</div>
					</div>

					<div class="searchbar-submit-cel">
						<small class="searchbar-field-label searchbar-field-label--spacer" aria-hidden="true">&nbsp;</small>
						<button class="btn btn-primary waves-effect waves-light searchbar-submit" type="submit">
							پیدا کن
							<i class="ti ti-search" aria-hidden="true"></i>
						</button>
					</div>
				</div>
			</div>
		</form>
	</div>
	</div>
</div>




<div class="position-relative trips-results">
	<div class="page-safezone">

				<div class="row ">
					<div class="col-3 d-none d-md-block trips-sidebar" style="padding-left:0.5rem !important;">
						<div class="trips-sidebar-sticky">
						<div class="card">
							<div class=" py-3 pe-4 ps-3" style="">
								<label class="direction-text mt-2 fw-normal d-block" style="font-weight: normal !important;">
									سفرهای سواری

									<strong class="fs-5">
									@ViewBag.origin_city_text
									</strong>
									به
									<strong >
									@ViewBag.dest_city_text
									</strong>
								</label>
								<label class="mt-1 ms-1">
									روز
									
										@(((Application.Services.PersianDate)ViewBag.searchpdate).DayOfWeek)


										<span class="ms-1">
										@(((Application.Services.PersianDate)ViewBag.searchpdate).ToShortDateString())
										</span>
								</label>
							</div>
						</div>
						<div class="card card-action mt-2">
							<div class="card-header">
								<div class="card-action-title oredring-title">
                                    <i class="ti ti-filter"></i>
                                  ترتیب بر اساس</div>
								<div class="card-action-element">
									<ul class="list-inline mb-0">
										<li class="list-inline-item">
											<a class="card-collapsible" href="javascript:void(0);">
												<i class="tf-icons ti ti-chevron-right scaleX-n1-rtl ti-sm"></i>
											</a>
										</li>
									</ul>
								</div>
							</div>
							<div class="collapse show" style="">
								<div class="card-body pt-0">
									<div class="form-check ">
                                        <input class="form-check-input" id="orderFilterSuggested" name="default-radio-1" type="radio" value="" checked onclick="orderFilterSelected(0)">
										<label class="form-check-label" for="orderFilterSuggested">پیشنهاد مسترشوفر</label>
									</div>
									<div class="form-check mt-2">
                                        <input class="form-check-input" id="orderFilterCheapest" name="default-radio-1" type="radio" value="" onclick="orderFilterSelected(2)">
										<label class="form-check-label fw-light" for="orderFilterCheapest">کمترین قیمت</label>
									</div>
									<div class="form-check mt-2">
                                        <input class="form-check-input" id="orderFilterPriciest" name="default-radio-1" type="radio" value="" onclick="orderFilterSelected(1)">
                                        <label class="form-check-label fw-light " for="orderFilterPriciest">بیشترین قیمت</label>
									</div>
								</div>
							</div>

						</div>

						<div class="card card-action mt-2">
							<div class="card-header">
								<div class="card-action-title oredring-title">
                                    <i class="ti ti-car"></i>
                                  خودرو</div>
								<div class="card-action-element">
									<ul class="list-inline mb-0">
										<li class="list-inline-item">
											<a class="card-collapsible" href="javascript:void(0);">
												<i class="tf-icons ti ti-chevron-right scaleX-n1-rtl ti-sm"></i>
											</a>
										</li>
									</ul>
								</div>
							</div>
							<div class="collapse show" style="">
								<div class="card-body pt-0" id="carmodelsfilter">
									<div class="form-check">
                                        <input class="form-check-input" id="defaultRadio2" name="default-radio-2" type="radio" value="" onclick="carFilterSelectes('default')" checked >
                                        <label class="form-check-label fw-bold" for="defaultRadio2" > همه</label>
									</div>
									
								</div>
							</div>

						</div>
						</div><!-- /.trips-sidebar-sticky -->
					</div>

                            <div class="col-12 col-md-9 px-1">

                                @await Html.PartialAsync("TimelinePartial", DateTime.Now)

                                <div class="card d-md-none mt-2 mb-2 trips-mobile-filters">
                                    <div class="card-body py-3">
                                        <div class="d-flex flex-wrap gap-2 align-items-center">
                                            <span class="small text-muted ms-1">ترتیب:</span>
                                            <div class="btn-group" role="group" aria-label="ترتیب نتایج">
                                                <input type="radio" class="btn-check" name="mobile-order" id="mobileOrderSuggested" autocomplete="off" checked onclick="orderFilterSelected(0)">
                                                <label class="btn btn-sm btn-outline-secondary" for="mobileOrderSuggested">پیشنهاد</label>
                                                <input type="radio" class="btn-check" name="mobile-order" id="mobileOrderCheapest" autocomplete="off" onclick="orderFilterSelected(2)">
                                                <label class="btn btn-sm btn-outline-secondary" for="mobileOrderCheapest">ارزان‌تر</label>
                                                <input type="radio" class="btn-check" name="mobile-order" id="mobileOrderPriciest" autocomplete="off" onclick="orderFilterSelected(1)">
                                                <label class="btn btn-sm btn-outline-secondary" for="mobileOrderPriciest">گران‌تر</label>
                                            </div>
                                        </div>
                                    </div>
                                </div>

							  
								<div class="trips-container">
                                
                                   <div class="d-flex justify-content-center align-items-center mt-5 pt-3">
                                        <div class="sk-chase sk-primary">
                                            <div class="sk-chase-dot"></div>
                                            <div class="sk-chase-dot"></div>
                                            <div class="sk-chase-dot"></div>
                                            <div class="sk-chase-dot"></div>
                                            <div class="sk-chase-dot"></div>
                                            <div class="sk-chase-dot"></div>

                                        </div>


                                        <label class="fw-bold fs-5 ms-3">
                                            در حال بارگذاری سفر ها
                                        </label>
                                   </div>


								</div>
							</div>

				</div>
	</div>
</div>

</div><!-- /.trips-page-shell -->





