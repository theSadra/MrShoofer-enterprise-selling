@using Application.Models
@{
	Layout = "_AgencySideLayout";
	ViewData["Title"] = "پروفایل آژانس";

	var agency = ViewBag.agency as Agency;
	var agancy_balance = ViewBag.agancy_balance != null ? Convert.ToInt64(ViewBag.agancy_balance) : 0L;
	var isOrganization = agency?.IsOrganization == true;
	var panelLabel = isOrganization ? "سازمانی" : "فروشنده";
	var hasFinancial = agency?.HasInvoiceFinancialInfo == true;
	var pendingTicket = TempData["PendingInvoiceTicketCode"] as string;
	if (!string.IsNullOrWhiteSpace(pendingTicket))
		TempData["PendingInvoiceTicketCode"] = pendingTicket;
	var invoiceBlocked = TempData["InvoiceBlocked"] as bool? == true;
}

@section VendorStyles {
	<link rel="stylesheet" href="~/vendor/libs/sweetalert2/sweetalert2.css" />
}

@section PageStyles {
	<link rel="stylesheet" href="~/css/fluent-color-icons.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/agency-dashboard.css" asp-append-version="true" />
}

@section VendorScripts {
	<script src="/libs/jquery.js"></script>
	<script src="~/vendor/libs/sweetalert2/sweetalert2.js"></script>
}

<div class="agency-dashboard agency-profile" dir="rtl">
	<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
		<div>
			<h4 class="mb-1">
				<span class="text-muted fw-light">آژانس /</span>
				پروفایل @(isOrganization ? "سازمان" : "آژانس")
			</h4>
			<small class="text-muted">اطلاعات هویتی، مالی و مدیریت اعتبار</small>
		</div>
		<span class="badge bg-label-primary">پنل @panelLabel</span>
	</div>

	<form method="post" asp-area="AgencyArea" asp-controller="Agency" asp-action="UpdateProfile" id="agencyProfileForm">
		@Html.AntiForgeryToken()

		<div class="card mb-4" id="profile">
			<div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
				<div class="d-flex align-items-center gap-2">
					<span class="agency-dashboard__kpi-icon" aria-hidden="true">
						<iconify-icon icon="fluent-color:building-24" width="26" height="26"></iconify-icon>
					</span>
					<div>
						<h5 class="card-title mb-0">اطلاعات @(isOrganization ? "سازمان" : "آژانس")</h5>
						<small class="text-muted">در پنل و سیستم مرکزی ذخیره می‌شود</small>
					</div>
				</div>
				<span class="badge bg-label-success d-inline-flex align-items-center gap-1">
					<iconify-icon icon="fluent-color:checkmark-circle-24" width="14" height="14" aria-hidden="true"></iconify-icon>
					تایید شده
				</span>
			</div>
			<div class="card-body">
				<div class="row g-3">
					<div class="col-md-6">
						<label class="form-label" for="profileName">نام @(isOrganization ? "سازمان" : "آژانس")</label>
						<input class="form-control" id="profileName" name="Name" required maxlength="200" value="@(agency?.Name)" />
					</div>
					<div class="col-md-6">
						<label class="form-label" for="profileAdmin">تلفن مدیر</label>
						<input class="form-control" id="profileAdmin" name="AdminMobile" dir="ltr" required maxlength="20" value="@(agency?.AdminMobile)" />
					</div>
					<div class="col-md-6">
						<label class="form-label" for="profilePhone">شماره تلفن</label>
						<input class="form-control" id="profilePhone" name="PhoneNumber" dir="ltr" maxlength="20" value="@(agency?.PhoneNumber)" />
					</div>
					<div class="col-12">
						<label class="form-label" for="profileAddress">آدرس</label>
						<textarea class="form-control" id="profileAddress" name="Address" rows="2" required maxlength="500">@(agency?.Address)</textarea>
					</div>
				</div>
			</div>
		</div>

		@if (isOrganization)
		{
		<div class="card mb-4" id="financial">
			<div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
				<div class="d-flex align-items-center gap-2">
					<span class="agency-dashboard__kpi-icon" aria-hidden="true">
						<iconify-icon icon="fluent-color:document-text-24" width="26" height="26"></iconify-icon>
					</span>
					<div>
						<h5 class="card-title mb-0">اطلاعات مالی / حقوقی</h5>
						<small class="text-muted">برای صدور فاکتور رسمی به نام سازمان لازم است</small>
					</div>
				</div>
				@if (hasFinancial)
				{
					<span class="badge bg-label-success">تکمیل‌شده</span>
				}
				else
				{
					<span class="badge bg-label-warning">ناقص</span>
				}
			</div>
			<div class="card-body">
				@if (!hasFinancial)
				{
					<div class="alert alert-warning mb-3">
						برای صدور فاکتور رسمی، کد اقتصادی، شماره ثبت و شناسه ملی را وارد کنید.
					</div>
				}
				<div class="row g-3">
					<div class="col-md-4">
						<label class="form-label">کد اقتصادی <span class="text-danger">*</span></label>
						<input class="form-control" dir="ltr" name="EconomicNo" value="@(agency?.EconomicNo)" autocomplete="off" />
					</div>
					<div class="col-md-4">
						<label class="form-label">شماره ثبت <span class="text-danger">*</span></label>
						<input class="form-control" dir="ltr" name="RegistrationNo" value="@(agency?.RegistrationNo)" autocomplete="off" />
					</div>
					<div class="col-md-4">
						<label class="form-label">شناسه ملی <span class="text-danger">*</span></label>
						<input class="form-control" dir="ltr" name="NationalId" value="@(agency?.NationalId)" autocomplete="off" />
					</div>
					<div class="col-md-4">
						<label class="form-label">نمابر</label>
						<input class="form-control" dir="ltr" name="Fax" value="@(agency?.Fax)" autocomplete="off" />
					</div>
					<div class="col-md-4">
						<label class="form-label">کد پستی</label>
						<input class="form-control" dir="ltr" name="PostalCode" value="@(agency?.PostalCode)" autocomplete="off" />
					</div>
					<div class="col-md-4">
						<label class="form-label">استان</label>
						<input class="form-control" name="Province" value="@(agency?.Province)" autocomplete="off" />
					</div>
					<div class="col-md-4">
						<label class="form-label">شهرستان</label>
						<input class="form-control" name="County" value="@(agency?.County)" autocomplete="off" />
					</div>
					<div class="col-md-4">
						<label class="form-label">شهر</label>
						<input class="form-control" name="City" value="@(agency?.City)" autocomplete="off" />
					</div>
				</div>
			</div>
		</div>
		}

		<div class="d-flex justify-content-end mb-4">
			<button type="submit" class="btn btn-primary" id="agencyProfileSubmitBtn">ذخیره تغییرات</button>
		</div>
	</form>

	<!-- Credit / account balance (مدیریت اعتبار) -->
	<div class="card mb-4" id="balance">
		<div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
			<div class="d-flex align-items-center gap-2">
				<span class="agency-dashboard__kpi-icon" aria-hidden="true">
					<iconify-icon icon="fluent-color:savings-24" width="26" height="26"></iconify-icon>
				</span>
				<div>
					<h5 class="card-title mb-0">مدیریت اعتبار</h5>
					<small class="text-muted">موجودی حساب و افزایش شارژ</small>
				</div>
			</div>
		</div>
		<div class="card-body">
			<div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
				<div>
					<small class="text-muted d-block">موجودی اعتبار</small>
					<p class="agency-dashboard__wallet-amount mb-0">
						@agancy_balance.ToString("N0")
						<small class="fs-6 fw-normal text-muted">تومان</small>
					</p>
				</div>
				<button class="btn btn-primary" data-bs-target="#referAndEarn" data-bs-toggle="modal" type="button">
					<iconify-icon class="fc-icon me-1" icon="fluent-color:add-circle-24" width="18" height="18" aria-hidden="true"></iconify-icon>
					افزایش موجودی
				</button>
			</div>
		</div>
	</div>
</div>

<div class="modal fade agency-charge-modal" id="referAndEarn" tabindex="-1" aria-labelledby="agencyChargeTitle" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
		<div class="modal-content">
			<div class="agency-charge-modal__header">
				<div class="agency-charge-modal__title-row">
					<span class="agency-charge-modal__icon" aria-hidden="true">
						<iconify-icon icon="fluent-color:savings-24" width="26" height="26"></iconify-icon>
					</span>
					<div>
						<h3 class="agency-charge-modal__title" id="agencyChargeTitle">افزایش موجودی</h3>
						<p class="agency-charge-modal__balance">
							موجودی فعلی:
							<strong>@agancy_balance.ToString("N0") تومان</strong>
						</p>
					</div>
				</div>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
			</div>

			<form id="paymentrequestform" autocomplete="off">
				<div class="agency-charge-modal__body">
					<label class="agency-charge-modal__label" for="amount">مبلغ شارژ</label>
					<div class="agency-charge-modal__amount-wrap">
						<input
							required
							class="form-control"
							id="amount"
							name="amount"
							inputmode="numeric"
							placeholder="2,000,000"
							type="text"
							aria-describedby="amountHelp" />
						<span class="agency-charge-modal__amount-unit">تومان</span>
					</div>
					<div class="agency-charge-modal__presets" role="group" aria-label="مبالغ پیشنهادی">
						<button type="button" class="agency-charge-modal__preset" data-amount="2000000">۲ میلیون</button>
						<button type="button" class="agency-charge-modal__preset" data-amount="5000000">۵ میلیون</button>
						<button type="button" class="agency-charge-modal__preset" data-amount="10000000">۱۰ میلیون</button>
						<button type="button" class="agency-charge-modal__preset" data-amount="20000000">۲۰ میلیون</button>
						<button type="button" class="agency-charge-modal__preset" data-amount="50000000">۵۰ میلیون</button>
					</div>
					<small id="amountHelp" class="text-muted d-block mt-2">حداقل مبلغ شارژ ۱٬۰۰۰ تومان است.</small>

					<label class="agency-charge-modal__label mt-3 mb-2">روش پرداخت</label>
					<div class="agency-charge-modal__methods" id="paymentMethodBtns" role="radiogroup" aria-label="روش پرداخت">
						<button type="button" class="agency-charge-modal__method is-active" data-value="اعتباری" aria-pressed="true">
							<span class="agency-charge-modal__method-icon" aria-hidden="true">
								<iconify-icon icon="fluent-color:coin-multiple-24" width="22" height="22"></iconify-icon>
							</span>
							<span>
								<span class="agency-charge-modal__method-title">
									درگاه پرداخت
									<span class="agency-charge-modal__badge">فوری</span>
								</span>
								<span class="agency-charge-modal__method-desc d-block">پرداخت آنلاین زرین‌پال و شارژ آنی کیف پول</span>
							</span>
						</button>
						<button type="button" class="agency-charge-modal__method" data-value="کارت به کارت" data-requires-support="true" aria-pressed="false">
							<span class="agency-charge-modal__method-icon" aria-hidden="true">
								<iconify-icon icon="fluent-color:phone-24" width="22" height="22"></iconify-icon>
							</span>
							<span>
								<span class="agency-charge-modal__method-title">کارت به کارت</span>
								<span class="agency-charge-modal__method-desc d-block">فقط از طریق تماس با پشتیبانی</span>
							</span>
						</button>
						<button type="button" class="agency-charge-modal__method" data-value="واریز به حساب" data-requires-support="true" aria-pressed="false">
							<span class="agency-charge-modal__method-icon" aria-hidden="true">
								<iconify-icon icon="fluent-color:building-24" width="22" height="22"></iconify-icon>
							</span>
							<span>
								<span class="agency-charge-modal__method-title">واریز به حساب</span>
								<span class="agency-charge-modal__method-desc d-block">فقط از طریق تماس با پشتیبانی</span>
							</span>
						</button>
						<button type="button" class="agency-charge-modal__method" data-value="سایر" data-requires-support="true" aria-pressed="false">
							<span class="agency-charge-modal__method-icon" aria-hidden="true">
								<iconify-icon icon="fluent-color:document-text-24" width="22" height="22"></iconify-icon>
							</span>
							<span>
								<span class="agency-charge-modal__method-title">سایر روش‌ها</span>
								<span class="agency-charge-modal__method-desc d-block">فقط از طریق تماس با پشتیبانی</span>
							</span>
						</button>
					</div>
				</div>

				<div class="agency-charge-modal__footer">
					<button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">انصراف</button>
					<button type="submit" class="btn btn-primary agency-charge-modal__submit" id="chargeSubmitBtn">
						پرداخت آنلاین
					</button>
				</div>
			</form>
		</div>
	</div>
</div>

<script>
	(function () {
		function formatAmount(raw) {
			var digits = String(raw || '').replace(/\D/g, '');
			if (!digits) return '';
			return digits.replace(/\B(?=(\d{3})+(?!\d))/g, ',');
		}

		function parseAmount(val) {
			return parseInt(String(val || '').replace(/,/g, ''), 10) || 0;
		}

		function gatewayButton() {
			return document.querySelector('#paymentMethodBtns .agency-charge-modal__method[data-value="اعتباری"]');
		}

		function selectMethod(btn) {
			if (!btn) return;
			document.querySelectorAll('#paymentMethodBtns .agency-charge-modal__method').forEach(function (el) {
				var on = el === btn;
				el.classList.toggle('is-active', on);
				el.setAttribute('aria-pressed', on ? 'true' : 'false');
			});
			var submitBtn = document.getElementById('chargeSubmitBtn');
			if (submitBtn) submitBtn.textContent = 'پرداخت آنلاین';
		}

		function showSupportAlert() {
			if (typeof Swal === 'undefined') {
				alert('برای انجام این عملیات لطفا با پشتیبانی تماس حاصل فرمایید 021-28422243');
				return;
			}
			Swal.fire({
				icon: 'info',
				title: 'تماس با پشتیبانی',
				html: 'برای انجام این عملیات لطفا با پشتیبانی تماس حاصل فرمایید<br><strong dir="ltr">021-28422243</strong>',
				confirmButtonText: 'متوجه شدم',
				buttonsStyling: false,
				customClass: { confirmButton: 'btn btn-primary waves-effect waves-light' }
			});
		}

		function selectPreset(amount) {
			var input = document.getElementById('amount');
			if (!input) return;
			input.value = formatAmount(amount);
			document.querySelectorAll('.agency-charge-modal__preset').forEach(function (el) {
				el.classList.toggle('is-active', Number(el.getAttribute('data-amount')) === Number(amount));
			});
		}

		document.addEventListener('DOMContentLoaded', function () {
			var amountInput = document.getElementById('amount');
			if (amountInput) {
				amountInput.addEventListener('input', function (e) {
					e.target.value = formatAmount(e.target.value);
					var n = parseAmount(e.target.value);
					document.querySelectorAll('.agency-charge-modal__preset').forEach(function (el) {
						el.classList.toggle('is-active', Number(el.getAttribute('data-amount')) === n);
					});
				});
			}

			document.querySelectorAll('.agency-charge-modal__preset').forEach(function (el) {
				el.addEventListener('click', function () {
					selectPreset(el.getAttribute('data-amount'));
				});
			});

			document.querySelectorAll('#paymentMethodBtns .agency-charge-modal__method').forEach(function (el) {
				el.addEventListener('click', function () {
					if (el.getAttribute('data-requires-support') === 'true') {
						selectMethod(gatewayButton());
						showSupportAlert();
						return;
					}
					selectMethod(el);
				});
			});

			selectMethod(gatewayButton());

			if (window.location.hash === '#balance') {
				var balanceEl = document.getElementById('balance');
				if (balanceEl) balanceEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
			} else if (window.location.hash === '#financial' || window.location.hash === '#profile') {
				var target = document.querySelector(window.location.hash);
				if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
			}
		});

		$(document).ready(function () {
			@if (TempData["ErrorMessage"] != null)
			{
				<text>
			Swal.fire({
				icon: 'error',
				title: 'خطا',
				text: '@Html.Raw(TempData["ErrorMessage"])',
				confirmButtonText: 'متوجه شدم',
				buttonsStyling: false,
				customClass: { confirmButton: 'btn btn-primary waves-effect waves-light' }
			});
				</text>
			}
			@if (TempData["SuccessMessage"] != null)
			{
				<text>
			Swal.fire({
				icon: 'success',
				title: 'انجام شد',
				text: '@Html.Raw(TempData["SuccessMessage"])',
				confirmButtonText: 'متوجه شدم',
				buttonsStyling: false,
				customClass: { confirmButton: 'btn btn-primary waves-effect waves-light' }
			});
				</text>
			}
			@if (TempData["PaymentError"] != null)
			{
				<text>
			Swal.fire({
				icon: 'error',
				title: 'خطا در پرداخت',
				text: '@Html.Raw(TempData["PaymentError"])',
				confirmButtonText: 'متوجه شدم',
				buttonsStyling: false,
				customClass: { confirmButton: 'btn btn-primary waves-effect waves-light' }
			});
				</text>
			}
			@if (TempData["PaymentSuccess"] != null)
			{
				<text>
			Swal.fire({
				icon: 'success',
				title: 'پرداخت موفق',
				text: '@Html.Raw(TempData["PaymentSuccess"])',
				confirmButtonText: 'متوجه شدم',
				buttonsStyling: false,
				customClass: { confirmButton: 'btn btn-primary waves-effect waves-light' }
			});
			gtag('event', 'conversion', {
				'send_to': 'AW-17843493402/WcYSCICR7s4cEJq0uLxC',
				'transaction_id': '@TempData["PaymentRefId"]'
			});
				</text>
			}
			@if (invoiceBlocked)
			{
				<text>
			Swal.fire({
				icon: 'warning',
				title: 'اطلاعات مالی تکمیل نشده',
				html: 'برای صدور فاکتور رسمی ابتدا اطلاعات مالی آژانس (کد اقتصادی، شماره ثبت و شناسه ملی) را تکمیل کنید.',
				showCancelButton: true,
				confirmButtonText: 'تکمیل اطلاعات مالی',
				cancelButtonText: 'انصراف',
				reverseButtons: true,
				allowOutsideClick: false,
				buttonsStyling: false,
				customClass: {
					confirmButton: 'btn btn-primary me-2',
					cancelButton: 'btn btn-outline-secondary'
				}
			}).then(function (result) {
				if (!result.isConfirmed) return;
				var el = document.getElementById('financial');
				if (el) {
					el.scrollIntoView({ behavior: 'smooth', block: 'start' });
					try { history.replaceState(null, '', '#financial'); } catch (e) { window.location.hash = 'financial'; }
				} else {
					window.location.hash = 'financial';
				}
			});
				</text>
			}

			$('#agencyProfileForm').on('submit', function () {
				var btn = document.getElementById('agencyProfileSubmitBtn');
				if (btn) {
					btn.disabled = true;
					btn.textContent = 'در حال ذخیره…';
				}
			});

			$('#agencyFinancialForm').on('submit', function () {
				var btn = document.getElementById('agencyFinancialSubmitBtn');
				if (btn) {
					btn.disabled = true;
					btn.textContent = 'در حال ذخیره…';
				}
			});

			var urlParams = new URLSearchParams(window.location.search);
			if (urlParams.get('openChargeModal') || window.location.hash === '#charge') {
				if (window.history.replaceState) {
					var cleanUrl = window.location.protocol + '//' + window.location.host + window.location.pathname;
					window.history.replaceState({ path: cleanUrl }, '', cleanUrl);
				}
			}

			$('#paymentrequestform').on('submit', function (e) {
				e.preventDefault();

				var active = document.querySelector('#paymentMethodBtns .agency-charge-modal__method.is-active');
				var method = active ? active.getAttribute('data-value') : 'اعتباری';
				var amount = parseAmount($('#amount').val());
				var submitBtn = document.getElementById('chargeSubmitBtn');

				if (method !== 'اعتباری') {
					selectMethod(gatewayButton());
					showSupportAlert();
					return;
				}

				if (!amount || amount < 1000) {
					Swal.fire({
						icon: 'warning',
						title: 'مبلغ نامعتبر',
						text: 'لطفاً مبلغ شارژ را وارد کنید (حداقل ۱۰۰۰ تومان).',
						confirmButtonText: 'متوجه شدم',
						buttonsStyling: false,
						customClass: { confirmButton: 'btn btn-primary waves-effect waves-light' }
					});
					return;
				}

				if (submitBtn) {
					submitBtn.disabled = true;
					submitBtn.textContent = 'در حال انتقال…';
				}
				var form = $('<form method="POST" action="/Payments/ZarinpalCharge"></form>');
				form.append($('<input type="hidden" name="amountToman">').val(amount));
				$('body').append(form);
				form.submit();
			});
		});
	})();
</script>
