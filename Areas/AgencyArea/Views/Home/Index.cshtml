                </div>
                <div class="col-lg-6 pt-lg-5 text-center text-lg-end">
                    <img src="/mrshooferserachdemo.png" alt="cta dashboard" class="img-fluid" style="max-height:250px;" />
                </div>
            </div>
        </div>
    </section>
