@{
    Layout = "_FrontLayout";

    ViewData["Title"] = "سواری بین شهری";
    ViewData["isSideMenu"] = true;
    ViewData["showFrontNavbar"] = true;

    var tripFocus = (Context.Request.Query["tripFocus"].ToString() ?? "").Trim().ToLowerInvariant();
    if (tripFocus is not ("intercity" or "airport" or "vip"))
    {
        tripFocus = "intercity";
    }

    var serviceMeta = tripFocus switch
    {
        "airport" => (
            Title: "ترانسفر فرودگاهی",
            Subtitle: "ترانسفر اختصاصی فرودگاهی با رانندگان تأییدشده",
            Icon: "ti-plane-departure"
        ),
        "vip" => (
            Title: "بیزینس پلاس",
            Subtitle: "سرویس ویژه سازمانی با خودرو و راننده منتخب",
            Icon: "ti-briefcase"
        ),
        _ => (
            Title: "سواری بین شهری",
            Subtitle: "مستر شوفر — سواری بین‌شهری و ترانسفر فرودگاهی با رانندگان تأییدشده",
            Icon: "ti-route"
        )
    };
}

@section VendorStyles {
    <link href="~/vendor/css/pages/front-page-landing.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/jalali-datepicker.css" asp-append-version="true" />
    <link href="~/css/IndexPage.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/trip-search.css" rel="stylesheet" asp-append-version="true" />
    <link rel="preload" href="/img/front-pages/landing-page/hero-travel.webp" as="image" type="image/webp" fetchpriority="high" />
    <link rel="preload" href="/img/front-pages/landing-page/hero-airport.webp" as="image" type="image/webp" />
    <style>
      .landing-hero .od-pair-col { position: relative; }

      /* OD field chrome — icons INSIDE inputs at RTL END (physical LEFT) */
      .landing-hero .input-container {
        position: relative;
        display: block;
      }

      .landing-hero #tripForm .input-container > .od-mark {
        position: absolute !important;
        top: 50% !important;
        /* Physical sides — icon at RTL end = physical left.
           Use explicit left/right (not inset-inline after left/right:auto). */
        left: 0.85rem !important;
        right: auto !important;
        bottom: auto !important;
        transform: translateY(-50%) !important;
        display: block;
        width: 0.95rem;
        height: 0.95rem;
        margin: 0 !important;
        padding: 0 !important;
        min-width: 0 !important;
        box-sizing: border-box;
        pointer-events: none;
        z-index: 3;
        color: #8b8b8b;
        line-height: 1;
        font-size: 1rem;
      }

      /* Origin = bullseye (ring + center dot) */
      .landing-hero .od-mark--origin {
        border: 2px solid #8b8b8b;
        border-radius: 50%;
        background: transparent;
      }
      .landing-hero .od-mark--origin::after {
        content: "";
        position: absolute;
        top: 50%;
        left: 50%;
        width: 0.35rem;
        height: 0.35rem;
        border-radius: 50%;
        background: #8b8b8b;
        transform: translate(-50%, -50%);
      }

      /* Destination = hollow square outline (empty inside, like origin) */
      .landing-hero .od-mark--dest {
        width: 0.78rem;
        height: 0.78rem;
        border: 2px solid #8b8b8b;
        border-radius: 0.22rem;
        background: transparent;
      }

      /* Date = calendar glyph, same slot */
      .landing-hero #tripForm .input-container > i.od-mark--date {
        width: auto;
        height: auto;
        font-size: 1.05rem;
        background: transparent;
        border: 0;
      }

      /* Room for the icon on the END (physical left) side */
      .landing-hero #tripForm .input-container input.origin,
      .landing-hero #tripForm .input-container input.destination,
      .landing-hero #tripForm .input-container input.searchdate {
        padding-inline-start: 0.95rem !important;
        padding-inline-end: 2.35rem !important;
        text-align: start;
        direction: rtl;
      }

      /* Help labels under each field — start-aligned (right in RTL), under the icon */
      .landing-hero #tripForm .inputcel > .form-text {
        display: block;
        width: 100%;
        margin: 0.4rem 0 0;
        padding: 0;
        text-align: start;
        font-size: 0.8125rem;
        line-height: 1.3;
        color: #8b8b8b;
      }

      /* Swap control — soft gray rounded square with muted arrows (secondary tone) */
      #landingHero #tripForm .od-swap-btn {
        --od-swap-size: 2rem;
        position: absolute !important;
        z-index: 4;
        width: var(--od-swap-size) !important;
        max-width: var(--od-swap-size) !important;
        height: var(--od-swap-size) !important;
        padding: 0 !important;
        margin: 0 !important;
        display: inline-flex !important;
        align-items: center;
        justify-content: center;
        border: 1px solid var(--ts-border, #e5e5e5);
        background: var(--secondary, #f3f3f3);
        color: var(--ts-ink, var(--brand-ink, #000));
        line-height: 1;
        box-shadow: 0 0 0 3px #fff, 0 2px 6px rgba(0, 0, 0, 0.12);
        cursor: pointer;
        transition: background-color .15s ease, border-color .15s ease, color .15s ease, transform .15s ease, box-shadow .15s ease;
      }
      #landingHero #tripForm .od-swap-btn:hover,
      #landingHero #tripForm .od-swap-btn:focus-visible {
        background: #e5e5e5;
        border-color: #d4d4d4;
        color: var(--ts-ink, var(--brand-ink, #000));
        outline: none;
      }
      @@media (max-width: 767.98px) {
        .landing-hero #tripForm .od-pair { --od-swap-gutter: 0 !important; }
        .landing-hero #tripForm .od-pair > .inputcel:first-child,
        .landing-hero #tripForm .od-pair > .inputcel:last-of-type {
          padding-inline: 0 !important;
          width: 100% !important;
          max-width: 100% !important;
          flex: 0 0 100% !important;
        }
        .landing-hero #tripForm .input-container > .od-mark {
          left: 0.85rem !important;
          right: auto !important;
        }
      }
      @@media (min-width: 768px) {
        /* Tight gutter so the swap control overlaps ~6px into each input edge.
           gutter (1.25rem = 20px) < button width (2rem = 32px).
           Uses #landingHero to override the shared trip-search.css default. */
        #landingHero #tripForm .od-pair { --od-swap-gutter: 1.25rem !important; }
        #landingHero #tripForm .od-pair > .inputcel:first-child {
          padding-inline-end: calc(var(--od-swap-gutter) / 2) !important;
        }
        #landingHero #tripForm .od-pair > .inputcel:last-of-type {
          padding-inline-start: calc(var(--od-swap-gutter) / 2) !important;
        }
        /* Centered horizontally between the two fields and vertically on the
           input midline (rendered input height ≈ 2.5rem → half ≈ 1.25rem). */
        #landingHero #tripForm .od-swap-btn {
          left: 50% !important;
          top: 1.25rem !important;
          bottom: auto !important;
          transform: translate(-50%, -50%) !important;
          border-radius: 0.65rem;
        }
        #landingHero #tripForm .od-swap-btn:active {
          transform: translate(-50%, -50%) scale(0.94) !important;
        }
      }
    </style>
}

