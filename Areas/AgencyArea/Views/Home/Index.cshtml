@{
    Layout = "_FrontLayout";

    ViewData["Title"] = "سواری بین شهری";
}

@section VendorStyles {
    <link href="~/vendor/css/pages/front-page-landing.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/jalali-datepicker.css" asp-append-version="true" />
    <link href="~/css/IndexPage.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/trip-search.css" rel="stylesheet" asp-append-version="true" />
    <link rel="preload" href="/img/front-pages/landing-page/hero-travel.webp" as="image" type="image/webp" fetchpriority="high" />
    <style>
      .landing-hero .od-pair-col { position: relative; }
      .landing-hero .od-swap-btn {
        --od-swap-size: 1.85rem;
        position: absolute !important;
        z-index: 4;
        width: var(--od-swap-size) !important;
        max-width: var(--od-swap-size) !important;
        height: var(--od-swap-size) !important;
        padding: 0 !important;
        margin: 0 !important;
        display: inline-flex !important;
        align-items: center;
        justify-content: center;
        border: 1px solid #d9dee3;
        background: #fff;
        color: #8592a3;
        line-height: 1;
        box-shadow: 0 0 0 2px #fff, 0 1px 2px rgba(47, 43, 61, 0.06);
        cursor: pointer;
      }
      @@media (max-width: 767.98px) {
        .landing-hero #tripForm .od-pair { --od-swap-gutter: 0 !important; }
        .landing-hero #tripForm .od-pair > .inputcel:first-child,
        .landing-hero #tripForm .od-pair > .inputcel:last-of-type {
          padding-inline: 0 !important;
          width: 100% !important;
          max-width: 100% !important;
          flex: 0 0 100% !important;
        }
      }
      @@media (min-width: 768px) {
        .landing-hero #tripForm .od-pair { --od-swap-gutter: 1rem; }
        .landing-hero #tripForm .od-pair > .inputcel:first-child {
          padding-inline-end: calc(var(--od-swap-gutter) / 2) !important;
        }
        .landing-hero #tripForm .od-pair > .inputcel:last-of-type {
          padding-inline-start: calc(var(--od-swap-gutter) / 2) !important;
        }
        .landing-hero .od-swap-btn {
          left: 50%;
          top: 0.25rem;
          transform: translateX(-50%);
          border-radius: 0.75rem;
        }
      }
    </style>
}

@section VendorScripts {
    <script src="~/libs/jquery.js"></script>
    <script src="~/vendor/libs/jdate/jdate.min.js" asp-append-version="true"></script>
    <script src="~/js/jalali-datepicker.js" asp-append-version="true"></script>
    <script src="~/js/IndexPage.js" asp-append-version="true"></script>
    <script src="~/js/searchpage.js" asp-append-version="true"></script>
}

@section PageScripts {

}


<div data-bs-spy="scroll" class="scrollspy-example">

    <!-- Hero: Start -->
    <section id="hero-animation">
        <div id="landingHero" class="landing-hero position-relative">
            <div class="landing-hero-stage">
                <div class="landing-hero-stage-art" aria-hidden="true">
                    <picture>
                        <source srcset="/img/front-pages/landing-page/hero-travel.webp" type="image/webp" />
                        <img src="/img/front-pages/landing-page/hero-travel.jpg"
                             alt=""
                             width="1600"
                             height="800"
                             class="landing-hero-stage-art-img"
                             fetchpriority="high"
                             decoding="async" />
                    </picture>
                </div>
                <div class="container landing-hero-stage-content">
                    <h1 class="visually-hidden">مستر شوفر — راهی مطمئن به همه مقاصد ایران</h1>
                    <div class="hero-text-box text-center"></div>
                </div>
            </div>

            <div class="container landing-hero-search-wrap">
                <div class="hero-safezone hero-safezone--form">
                    <div class="hero-search-panel">
                        <div class="hero-search-head d-flex justify-content-between align-items-center">
                            <div>
                                <p class="mb-1 fw-semibold h5">
                                    <i class="ti ti-route me-1 text-primary"></i>
                                    جستجوی سواری
                                </p>
                                <p class="mb-0 text-muted small">
                                    مستر شوفر — سواری بین‌شهری و ترانسفر فرودگاهی با رانندگان تأییدشده
                                    <i class="ti ti-circle-check text-success ms-1"></i>
                                </p>
                            </div>
                            <img src="/mrshoofer_cars_banner.webp" width="72" height="72" class="d-none d-md-block" alt="ناوگان سواری رسمی مستر شوفر" decoding="async" />
                        </div>

                        <form asp-controller="TaxiTrips" asp-action="Index" method="get" class="row g-3 m-0" id="tripForm">
                            <div class="col-12 col-md-6 od-pair-col">
                                <div class="row g-2 g-md-0 od-pair">
                                    <div class="col-12 col-md-6 inputcel">
                                        <label class="form-text d-md-none d-block" for="origin_input" id="originHelpMobile">شهر مبدا سفر</label>
                                        <div class="input-container">
                                            <input autocomplete="off" autocapitalize="off" spellcheck="false"
                                                   aria-describedby="originHelpDesktop originHelpMobile"
                                                   aria-autocomplete="list" aria-haspopup="listbox"
                                                   data-bs-toggle="dropdown" data-bs-offset="0,8"
                                                   class="form-control origin input-field dropdown-toggle hide-arrow"
                                                   id="origin_input" placeholder="مبدا" type="text" role="combobox"
                                                   name="originstring" />
                                            <i class="ti ti-location mb-2 icon" aria-hidden="true"></i>
                                            <div class="dropdown-menu origin_location"></div>
                                        </div>
                                        <div class="form-text d-md-block d-none" id="originHelpDesktop">شهر مبدا سفر</div>
                                    </div>

                                    <div class="col-12 col-md-6 inputcel">
                                        <label class="form-text d-block d-md-none" for="destination_input" id="destinationHelpMobile">شهر مقصد سفر</label>
                                        <div class="input-container">
                                            <input data-bs-toggle="dropdown" data-bs-offset="0,8" autocomplete="off" autocapitalize="off" spellcheck="false"
                                                   aria-describedby="destinationHelpDesktop destinationHelpMobile"
                                                   aria-autocomplete="list" aria-haspopup="listbox"
                                                   class="form-control destination input-field dropdown-toggle hide-arrow"
                                                   id="destination_input" placeholder="مقصد" type="text" role="combobox"
                                                   name="destinationstring" />
                                            <i class="ti ti-map-pin mb-2 icon" aria-hidden="true"></i>
                                            <div class="dropdown-menu destination_location"></div>
                                        </div>
                                        <div class="form-text d-none d-md-block" id="destinationHelpDesktop">شهر مقصد سفر</div>
                                    </div>
                                </div>
                                <button type="button" class="od-swap-btn" id="od-swap-btn" title="جابه‌جایی مبدأ و مقصد" aria-label="جابه‌جایی مبدأ و مقصد">
                                    <i class="ti ti-arrows-left-right" aria-hidden="true"></i>
                                </button>
                            </div>

                            <div class="col-12 col-md-3 inputcel">
                                <label class="form-text d-block d-md-none" for="starttime" id="dateHelpMobile">انتخاب تاریخ</label>
                                <div class="input-container">
                                    <input autocomplete="off" aria-describedby="dateHelpDesktop dateHelpMobile" class="form-control bdi starttimeselector searchdate" id="starttime" placeholder="تاریخ سفر" type="text" name="searchdate" />
                                    <i class="ti ti-calendar-stats mb-2 icon pe-0" aria-hidden="true"></i>
                                </div>
                                <div class="form-text d-none d-md-block" id="dateHelpDesktop">انتخاب تاریخ</div>
                            </div>

                            <div class="col-12 col-md-3 inputcel">
                                <div class="ps-0">
                                    <button class="btn btn-primary waves-effect waves-light btn-lg search-submit-btn" type="submit">
                                        بزن بریم
                                        <i class="ti ti-search" aria-hidden="true"></i>
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>

                    <div class="hero-trust-stats">
                        <div class="hero-trust-stat">
                            <i class="ti ti-route" aria-hidden="true"></i>
                            <span><strong>۵۰۰+</strong> مسیر فعال</span>
                        </div>
                        <div class="hero-trust-stat">
                            <i class="ti ti-steering-wheel" aria-hidden="true"></i>
                            <span><strong>۱۲۰۰+</strong> راننده تأییدشده</span>
                        </div>
                        <div class="hero-trust-stat">
                            <i class="ti ti-headset" aria-hidden="true"></i>
                            <span>پشتیبانی <strong>۲۴/۷</strong></span>
                        </div>
                        <div class="hero-trust-stat">
                            <i class="ti ti-shield-check" aria-hidden="true"></i>
                            <span>سفر <strong>مطمئن</strong> و بیمه‌شده</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- Hero: End -->
    <!-- Useful features: Start -->
