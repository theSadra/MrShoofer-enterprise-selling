<script>
    $(document).ready(function () {
        $('#contact-us').on('submit', function (event) {
            event.preventDefault();

            var name = $('#name').val();
            var number = $('#number').val();
            var message = $('#message').val();



            $.ajax({
                url: '/Message',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ name: name, number: number, message: message }),

                success: function (response) {
                    Swal.fire({
                        title: 'پیام شما ثبت شد',
                        text: 'با تشکر از شما، پیام شما در اسرع وقت و با ارجعیت، توسط کارشناسان ما برسی خواهد شد.',
                        confirmButtonText: 'باشه',
                        icon: 'success',
                        customClass: {
                            confirmButton: 'btn btn-primary waves-effect waves-light'
                        },
                        buttonsStyling: false
                    });
                    // Optionally, clear the form fields
                    $('#contact-us')[0].reset();
                },
                error: function (xhr, status, error) {
                    $('#contact-us')[0].reset();

                    Swal.fire({
                        icon: "error",
                        title: "پیام شما ثبت نشد",
                        text: "پیام شما در سیستم ثبت نشد",
                    });
                }
            });
            
        });
    });
</script>
